<Project>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\*.sync-conflict-*</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Release artifacts are distributed per RID. Bundle managed assemblies into the apphost and
       compress them, while leaving app-owned native libraries beside it so the platform loaders
       and their integrity checks keep working. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != '' and '$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">false</IncludeNativeLibrariesForSelfExtract>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>
  <!-- File-sync conflict copies are recovery artifacts. Preserve them on disk, but do not let
       SDK/Avalonia wildcard items compile or package duplicate source and resources. -->
  <ItemGroup>
    <Compile Remove="**\*.sync-conflict-*" />
    <AvaloniaResource Remove="**\*.sync-conflict-*" />
    <AvaloniaXaml Remove="**\*.sync-conflict-*" />
    <EmbeddedResource Remove="**\*.sync-conflict-*" />
    <Content Remove="**\*.sync-conflict-*" />
    <None Remove="**\*.sync-conflict-*" />
  </ItemGroup>
</Project>
