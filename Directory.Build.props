<Project>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\*.sync-conflict-*</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Reviewed unreachable ImageSharp paths; see SECURITY.md. Keep NuGet audit and all
       other advisory warnings enabled. Reassess these exceptions when ImageSharp usage changes. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

  <!-- Release artifacts keep app-owned native libraries beside the executable. The 1.8.2
       single-file apphost could terminate before Avalonia initialized when dyld/.NET resolved
       bundled native dependencies; all release RIDs therefore use the separate-file layout. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>false</PublishSingleFile>
    <PublishSingleFile Condition="$(RuntimeIdentifier.StartsWith('osx'))">false</PublishSingleFile>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>
  <!-- File-sync conflict copies are recovery artifacts. Preserve them on disk, but do not let
       SDK/Avalonia wildcard items compile or package duplicate source and resources. -->
  <ItemGroup>
    <Compile Remove="**\*.sync-conflict-*" />
    <AvaloniaResource Remove="**\*.sync-conflict-*" />
    <AvaloniaXaml Remove="**\*.sync-conflict-*" />
    <EmbeddedResource Remove="**\*.sync-conflict-*" />
    <Content Remove="**\*.sync-conflict-*" />
    <None Remove="**\*.sync-conflict-*" />
  </ItemGroup>
</Project>
