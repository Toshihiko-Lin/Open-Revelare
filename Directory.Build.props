<Project>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\*.sync-conflict-*</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Release artifacts keep app-owned native libraries beside the executable. The 1.8.2
       single-file apphost could terminate before Avalonia initialized when dyld/.NET resolved
       bundled native dependencies; all release RIDs therefore use the separate-file layout. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>false</PublishSingleFile>
    <PublishSingleFile Condition="$(RuntimeIdentifier.StartsWith('osx'))">false</PublishSingleFile>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>
  <!-- File-sync conflict copies are recovery artifacts. Preserve them on disk, but do not let
       SDK/Avalonia wildcard items compile or package duplicate source and resources. -->
  <ItemGroup>
    <Compile Remove="**\*.sync-conflict-*" />
    <AvaloniaResource Remove="**\*.sync-conflict-*" />
    <AvaloniaXaml Remove="**\*.sync-conflict-*" />
    <EmbeddedResource Remove="**\*.sync-conflict-*" />
    <Content Remove="**\*.sync-conflict-*" />
    <None Remove="**\*.sync-conflict-*" />
  </ItemGroup>
</Project>
