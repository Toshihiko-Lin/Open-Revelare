<Project>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\*.sync-conflict-*</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Release artifacts keep native and managed files separately so platform loaders can resolve
       app-owned libraries from the publish directory. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>
  <!-- File-sync conflict copies are recovery artifacts. Preserve them on disk, but do not let
       SDK/Avalonia wildcard items compile or package duplicate source and resources. -->
  <ItemGroup>
    <Compile Remove="**\*.sync-conflict-*" />
    <AvaloniaResource Remove="**\*.sync-conflict-*" />
    <AvaloniaXaml Remove="**\*.sync-conflict-*" />
    <EmbeddedResource Remove="**\*.sync-conflict-*" />
    <Content Remove="**\*.sync-conflict-*" />
    <None Remove="**\*.sync-conflict-*" />
  </ItemGroup>
</Project>
