<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  只在用 Developer ID 签名（--sign）时使用 —— 公证要求开 hardened runtime，而 hardened
  runtime 默认禁掉的三件事恰好是 .NET 必需的：
    · allow-jit / allow-unsigned-executable-memory —— CoreCLR 的 JIT 要可写可执行内存；
      缺了应用一启动就被内核干掉。
    · disable-library-validation —— 我们加载的 libraw.23.dylib 与 onnxruntime 不是
      同一个 Team ID 签的（前者是 bundle-libraw.sh 就地 ad-hoc 签的）。
  ad-hoc 签名（默认路径）不开 hardened runtime，用不到本文件。
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>                           <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>    <true/>
  <key>com.apple.security.cs.disable-library-validation</key>          <true/>
</dict>
</plist>
