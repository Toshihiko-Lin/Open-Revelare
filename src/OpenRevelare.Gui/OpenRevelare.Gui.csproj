<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Single source of the app version (Services/AppInfo). Read by the About box, the update
         check and open-revelare.iss, and checked against the git tag by release.yml's guard job. -->
    <Version>1.8.5</Version>
    <!-- Also the assembly name, hence the avares://OpenRevelare/ resource URIs. -->
    <AssemblyName>OpenRevelare</AssemblyName>
    <AssemblyTitle>OpenRevelare</AssemblyTitle>
    <Product>OpenRevelare</Product>
    <Company>Toshihiko-Lin</Company>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Windows shell icon (Explorer / taskbar pin / Alt-Tab). The .ico carries the whole
         16→256 ladder; the window icon at runtime comes from the PNG next to it. -->
    <ApplicationIcon>Assets\icons\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Loc.T / Loc.F are reached from nearly every file that puts text on screen, and a
       per-file `using OpenRevelare.Gui.Services;` would also drag Settings, Catalog, ImageIo …
       into scope wherever a single string needed translating. An alias imports the one name. -->
  <ItemGroup>
    <Using Include="OpenRevelare.Gui.Services.Loc" Alias="Loc" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The .ico is a build input for ApplicationIcon and the .svg is the vector master;
         neither is loadable by Avalonia, so keep them out of the embedded resources. -->
    <AvaloniaResource Remove="Assets\icons\app.ico" />
    <AvaloniaResource Remove="Assets\icons\app.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Pinned to the EXACT version Avalonia.Skia 11.2.3 depends on. The preview draws through
         SkiaSharp directly (Interop/ColorManagedImage.cs) to get a colour space onto the bitmap,
         which Avalonia's own bitmap API cannot express; sharing Avalonia's Skia is the whole
         point, so a version drift here would mean two SkiaSharp natives in one process. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <!-- LaTeX typesetting for the formulae in the bundled documents (MIT, plus OFL-1.1 for the
         bundled math font). The Avalonia port of WpfMath / xaml-math. -->
    <PackageReference Include="AvaloniaMath" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRevelare.Core\OpenRevelare.Core.csproj" />
    <ProjectReference Include="..\OpenRevelare.Presentation\OpenRevelare.Presentation.csproj" />
    <ProjectReference Include="..\OpenRevelare.Presentation.Win32\OpenRevelare.Presentation.Win32.csproj" />
    <ProjectReference Include="..\OpenRevelare.Presentation.MacOS\OpenRevelare.Presentation.MacOS.csproj" />
    <!-- Deep-WB backend. Brings onnxruntime (and the net_awb.onnx Content item) with it, so the
         GUI no longer names the package or the model itself: there is ONE implementation of
         IDeepWbCorrector and ONE copy of the weights. The GUI used to carry a private second
         corrector plus its own embedded copy of the 17 MB model — which also meant the CLI's
         parity harness was verifying a resampler the GUI did not use. -->
    <ProjectReference Include="..\OpenRevelare.DeepWb.Onnx\OpenRevelare.DeepWb.Onnx.csproj" />
  </ItemGroup>
</Project>
