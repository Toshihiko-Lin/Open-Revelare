<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:OpenRevelare.Gui.Markup"
        xmlns:vm="using:OpenRevelare.Gui.ViewModels"
        xmlns:ctl="using:OpenRevelare.Gui.Controls"
        xmlns:views="using:OpenRevelare.Gui.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="840"
        x:Class="OpenRevelare.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="840"
        Background="{DynamicResource BgBrush}"
        Title="OpenRevelare">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- ══ Menu bar ═══════════════════════════════════════════════════════
             Everything low-frequency lives here (same 文件/编辑/视图/设置/帮助
             spine as the Python build). The strip keeps only the three commands
             you actually hit mid-edit: 撤销 / 重做 / 重置.

             The five top-level headers stay ENGLISH in both languages — they are
             the fixed landmarks of the window, they are what every screenshot and
             every line of the docs points at ("文件 → 导出印样…"), and File/Edit/
             View is read as an icon rather than as a word. Everything INSIDE them
             is translated as usual.
             ═══════════════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Padding="6,3" Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Menu Grid.Column="0" VerticalAlignment="Center">
                    <MenuItem Header="_File" SubmenuOpened="OnFileMenuOpened">
                        <MenuItem Header="{i18n:T '新建卷…'}" InputGesture="Ctrl+N" Click="OnOpenClick" />
                        <MenuItem Header="{i18n:T '添加图像到当前卷…'}" InputGesture="Ctrl+O"
                                  Click="OnAddImagesClick" IsEnabled="{Binding HasImage}" />
                        <Separator />
                        <!-- Filled in when the 文件 menu opens (OnFileMenuOpened) — the catalog
                             changes as rolls are imported, so it cannot be a static list. -->
                        <MenuItem Name="RecentRollsMenu" Header="{i18n:T '最近的卷'}" />
                        <MenuItem Header="{i18n:T '打开工程…'}" Click="OnOpenProjectClick" />
                        <MenuItem Header="{i18n:T '扫描文件夹加入目录…'}" Click="OnScanFolderClick"
                                  ToolTip.Tip="{i18n:T '找出该文件夹（含子文件夹）里所有 .ncproj 并登记到图库；目录丢了也能这样重建'}" />
                        <MenuItem Header="{i18n:T '另存工程副本…'}" Click="OnSaveProjectClick" IsEnabled="{Binding HasImage}"
                                  ToolTip.Tip="{i18n:T '当前卷会自动保存；这里是导出一份副本'}" />
                        <Separator />
                        <MenuItem Header="{i18n:T '导出当前帧…'}" InputGesture="Ctrl+E"
                                  Click="OnExportClick" IsEnabled="{Binding HasImage}">
                            <MenuItem.Icon>
                                <ctl:Icon Data="{StaticResource IcoExport}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{i18n:T '导出整卷…'}" Click="OnExportRollClick" IsEnabled="{Binding HasImage}" />
                        <MenuItem Header="{i18n:T '导出印样…'}" Click="OnContactSheetClick" IsEnabled="{Binding HasImage}">
                            <MenuItem.Icon>
                                <ctl:Icon Data="{StaticResource IcoGrid}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{i18n:T '退出'}" InputGesture="Alt+F4" Click="OnQuitClick" />
                    </MenuItem>

                    <MenuItem Header="_Edit">
                        <MenuItem Header="{i18n:T '撤销'}" InputGesture="Ctrl+Z" Click="OnUndoClick" IsEnabled="{Binding CanUndo}">
                            <MenuItem.Icon>
                                <ctl:Icon Data="{StaticResource IcoUndo}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{i18n:T '重做'}" InputGesture="Ctrl+Y" Click="OnRedoClick" IsEnabled="{Binding CanRedo}">
                            <MenuItem.Icon>
                                <ctl:Icon Data="{StaticResource IcoRedo}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{i18n:T '重置本帧调整'}" Click="OnResetClick" IsEnabled="{Binding HasImage}" />
                        <Separator />
                        <MenuItem Header="{i18n:T '复制（按当前面板）'}" InputGesture="Ctrl+C"
                                  Click="OnCopyActiveClick" IsEnabled="{Binding HasImage}"
                                  ToolTip.Tip="{i18n:T '整卷校准面板 → 复制标定；帧编辑面板 → 复制场景'}">
                            <MenuItem.Icon>
                                <ctl:Icon Data="{StaticResource IcoCopy}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{i18n:T '粘贴到本帧（按当前面板）'}" InputGesture="Ctrl+V"
                                  Click="OnPasteActiveClick" IsEnabled="{Binding HasImage}">
                            <MenuItem.Icon>
                                <ctl:Icon Data="{StaticResource IcoCheck}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{i18n:T '标定（Stage 1）'}" IsEnabled="{Binding HasImage}">
                            <MenuItem Header="{i18n:T '复制标定'}" Click="OnCopyCalClick">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoCopy}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{i18n:T '粘贴标定到本帧'}" Click="OnPasteCalToCurrentClick"
                                      IsEnabled="{Binding HasCalClipboard}">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoCheck}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{i18n:T '应用标定到勾选帧'}" Click="OnPasteCalClick"
                                      IsEnabled="{Binding HasCalClipboard}" />
                            <MenuItem Header="{i18n:T '应用标定到整卷'}" Click="OnApplyCalToRollClick" />
                        </MenuItem>
                        <MenuItem Header="{i18n:T '场景（Stage 2）'}" IsEnabled="{Binding HasImage}">
                            <MenuItem Header="{i18n:T '复制场景'}" Click="OnCopySceneClick">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoCopy}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{i18n:T '粘贴场景到本帧'}" Click="OnPasteSceneToCurrentClick"
                                      IsEnabled="{Binding HasSceneClipboard}">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoCheck}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{i18n:T '应用场景到勾选帧'}" Click="OnPasteSceneClick"
                                      IsEnabled="{Binding HasSceneClipboard}" />
                            <MenuItem Header="{i18n:T '应用场景到整卷'}" Click="OnApplySceneToRollClick" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{i18n:T '选择同步项…'}" Click="OnSyncOptionsClick" IsEnabled="{Binding HasImage}" />
                    </MenuItem>

                    <MenuItem Header="_View">
                        <MenuItem Header="{i18n:T '图库（卷墙）'}" InputGesture="G" Click="OnLibraryModeClick">
                            <MenuItem.Icon>
                                <ctl:Icon Data="{StaticResource IcoGrid}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{i18n:T '修片'}" InputGesture="D" Click="OnDevelopModeClick" IsEnabled="{Binding HasImage}">
                            <MenuItem.Icon>
                                <ctl:Icon Data="{StaticResource IcoWand}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{i18n:T '查看负片'}" InputGesture="N" Click="OnMenuViewNegClick" IsEnabled="{Binding HasImage}">
                            <MenuItem.Icon>
                                <ctl:Icon Data="{StaticResource IcoFilm}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{i18n:T '前后对比'}" InputGesture="K" Click="OnMenuCompareClick" IsEnabled="{Binding HasImage}">
                            <MenuItem.Icon>
                                <ctl:Icon Data="{StaticResource IcoCompare}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{i18n:T '适合窗口'}" InputGesture="F" Click="OnFitClick" IsEnabled="{Binding HasImage}">
                            <MenuItem.Icon>
                                <ctl:Icon Data="{StaticResource IcoFit}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{i18n:T '实际像素 100%（Ctrl+1）'}" Click="OnActualSizeClick"
                                  IsEnabled="{Binding HasImage}">
                            <MenuItem.Icon>
                                <ctl:Icon Data="{StaticResource IcoActual}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{i18n:T '显示齿孔遮罩'}" ToggleType="CheckBox"
                                  IsChecked="{Binding ShowSprocketMask, Mode=TwoWay}"
                                  IsEnabled="{Binding HasImage}" />
                        <Separator />
                        <MenuItem Header="{i18n:T '预览背景色'}" Name="BgMenu">
                            <MenuItem Header="{i18n:T '白'}" Tag="#FFFFFF" ToggleType="Radio" GroupName="viewerbg" Click="OnViewerBgClick" />
                            <MenuItem Header="{i18n:T '浅灰'}" Tag="#B4B4B4" ToggleType="Radio" GroupName="viewerbg" Click="OnViewerBgClick" />
                            <MenuItem Header="{i18n:T '中灰（默认）'}" Tag="#5E5E5E" ToggleType="Radio" GroupName="viewerbg" Click="OnViewerBgClick" />
                            <MenuItem Header="{i18n:T '18% 中性灰'}" Tag="#777777" ToggleType="Radio" GroupName="viewerbg" Click="OnViewerBgClick" />
                            <MenuItem Header="{i18n:T '深灰'}" Tag="#323232" ToggleType="Radio" GroupName="viewerbg" Click="OnViewerBgClick" />
                            <MenuItem Header="{i18n:T '黑'}" Tag="#0E0F11" ToggleType="Radio" GroupName="viewerbg" Click="OnViewerBgClick" />
                        </MenuItem>
                        <MenuItem Header="{i18n:T '切换浅色/深色主题'}" InputGesture="Ctrl+Shift+T" Click="OnToggleThemeClick" />
                    </MenuItem>

                    <MenuItem Header="_Settings">
                        <MenuItem Header="{i18n:T '偏好设置…（Ctrl+,）'}" Click="OnPreferencesClick" />
                    </MenuItem>

                    <MenuItem Header="_Help">
                        <MenuItem Header="{i18n:T '操作指引 / 技术原理…'}" Click="OnDocsClick" />
                        <MenuItem Header="{i18n:T '快捷键与上手…'}" Click="OnHelpClick" />
                        <Separator />
                        <MenuItem Header="{i18n:T '检查更新…'}" Click="OnCheckUpdateClick" />
                        <Separator />
                        <MenuItem Header="{i18n:T '关于 OpenRevelare'}" Click="OnAboutClick" />
                    </MenuItem>
                </Menu>

                <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Margin="16,0"
                           TextTrimming="CharacterEllipsis"
                           FontSize="12" Foreground="{DynamicResource TextMuteBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <!-- Module switch. One button, because there are only two modules and the
                         icon says which one you are going to. -->
                    <Button Name="ModuleButton" Classes="icon" Click="OnToggleModuleClick"
                            ToolTip.Tip="{i18n:T '图库 / 修片 切换（G / D）'}">
                        <ctl:Icon Data="{StaticResource IcoGrid}" />
                    </Button>
                    <Border Width="1" Margin="4,4" Background="{DynamicResource BorderSoftBrush}" />
                    <Button Name="UndoButton" Classes="icon" Click="OnUndoClick" IsEnabled="{Binding CanUndo}"
                            ToolTip.Tip="{i18n:T '撤销（Ctrl+Z）'}">
                        <ctl:Icon Data="{StaticResource IcoUndo}" />
                    </Button>
                    <Button Name="RedoButton" Classes="icon" Click="OnRedoClick" IsEnabled="{Binding CanRedo}"
                            ToolTip.Tip="{i18n:T '重做（Ctrl+Y）'}">
                        <ctl:Icon Data="{StaticResource IcoRedo}" />
                    </Button>
                    <Button Name="ResetButton" Classes="icon" Click="OnResetClick" IsEnabled="{Binding HasImage}"
                            ToolTip.Tip="{i18n:T '重置本帧调整'}">
                        <ctl:Icon Data="{StaticResource IcoReset}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Status bar ──────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Padding="10,4" Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressBar IsIndeterminate="True" Width="120" Height="3"
                             IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                <!-- Background stage (解耦矩阵 / 色度补偿 / 后台解码 …). Its own field so roll
                     progress and the current frame name never overwrite each other. -->
                <Border IsVisible="{Binding BackgroundStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="7,1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding BackgroundStatus}" VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- The two modules overlay each other and swap by visibility. They must share ONE
             DockPanel slot: docked siblings each claim an edge, and the wall would get a narrow
             left-hand strip to lay its cards out in. -->
        <Panel>

        <!-- ── 图库模块：卷墙 ───────────────────────────────────────────── -->
        <views:LibraryView Name="Library" DataContext="{Binding Library}"
                           IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsLibraryMode}" />

        <!-- ── 3-pane split: film strip | preview | tabs ───────────────── -->
        <Grid ColumnDefinitions="150,Auto,*,Auto,430" IsVisible="{Binding !IsLibraryMode}">

            <!-- Col 0 — film strip. Add / virtual copy / remove used to be a row of three
                 buttons stealing the top of the strip; they are right-click items now
                 (same as the Python build), so the strip is all thumbnails. -->
            <Border Grid.Column="0" Background="{DynamicResource Panel2Brush}" IsVisible="{Binding HasImage}">
                <ListBox Name="FilmStrip" Classes="filmstrip" ItemsSource="{Binding Frames}"
                         SelectedItem="{Binding CurrentFrame}" Background="Transparent" Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{i18n:T '添加图像到当前卷…'}" Click="OnAddImagesClick">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoPlus}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{i18n:T '创建虚拟副本'}" Click="OnVirtualCopyClick"
                                      ToolTip.Tip="{i18n:T '继承标定、重置场景，可独立调整'}">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoLayers}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{i18n:T '从卷中移除'}" Click="OnRemoveFrameClick">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoTrash}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{i18n:T '复制标定'}" Click="OnCopyCalClick">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoCopy}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{i18n:T '粘贴标定到本帧'}" Click="OnPasteCalToCurrentClick"
                                      IsEnabled="{Binding HasCalClipboard}">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoCheck}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{i18n:T '应用标定到勾选帧'}" Click="OnPasteCalClick"
                                      IsEnabled="{Binding HasCalClipboard}" />
                            <MenuItem Header="{i18n:T '应用标定到整卷'}" Click="OnApplyCalToRollClick" />
                            <Separator />
                            <MenuItem Header="{i18n:T '复制场景'}" Click="OnCopySceneClick" />
                            <MenuItem Header="{i18n:T '粘贴场景到本帧'}" Click="OnPasteSceneToCurrentClick"
                                      IsEnabled="{Binding HasSceneClipboard}" />
                            <MenuItem Header="{i18n:T '应用场景到勾选帧'}" Click="OnPasteSceneClick"
                                      IsEnabled="{Binding HasSceneClipboard}" />
                            <MenuItem Header="{i18n:T '应用场景到整卷'}" Click="OnApplySceneToRollClick" />
                            <Separator />
                            <MenuItem Header="{i18n:T '选择同步项…'}" Click="OnSyncOptionsClick" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="1">
                                <Grid>
                                    <!-- Pending: the frame is in the roll, its decode has not run yet.
                                         Quiet neutral panel — this is a wait state, not a warning. -->
                                    <Border Width="104" Height="76" IsVisible="{Binding IsPending}"
                                            Background="{DynamicResource ChromeBrush}"
                                            BorderBrush="{DynamicResource BorderSoftBrush}"
                                            BorderThickness="1" CornerRadius="2">
                                        <TextBlock Text="{i18n:T '解码中…'}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuteBrush}" />
                                    </Border>
                                    <Image Source="{Binding Thumbnail}" Height="76" Stretch="Uniform" />
                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Left"
                                              VerticalAlignment="Top"
                                              ToolTip.Tip="{i18n:T '勾选为「应用到勾选帧」的目标'}" />
                                </Grid>
                                <TextBlock Text="{Binding Label}" FontSize="10" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TextMuteBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource BorderSoftBrush}" />

            <!-- Col 2 — preview (top bar / viewer / bottom bar) -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                <!-- Top bar: only the two view STATES (they need a visible lit indicator);
                     zoom lives on the right as glyphs. Everything else is right-click. -->
                <Border Grid.Row="0" Padding="8,4" Background="{DynamicResource ChromeBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <ToggleButton Name="ViewNegBtn" Click="OnViewNegToggle" IsEnabled="{Binding HasImage}"
                                          Padding="9,5"
                                          ToolTip.Tip="{i18n:T '临时切到（带 gamma 的）负片视图，便于对准片基/齿孔（N）'}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ctl:Icon Data="{StaticResource IcoFilm}" />
                                    <TextBlock Text="{i18n:T '负片'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Name="CompareBtn" Click="OnCompareToggle" IsEnabled="{Binding HasImage}"
                                          Padding="9,5"
                                          ToolTip.Tip="{i18n:T '显示未做帧编辑（Stage 2）的画面，用于前后对比（K）'}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ctl:Icon Data="{StaticResource IcoCompare}" />
                                    <TextBlock Text="{i18n:T '对比'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <TextBlock Name="ZoomLabel" Text="100%" VerticalAlignment="Center"
                                       Margin="0,0,6,0" MinWidth="38" TextAlignment="Right"
                                       Foreground="{DynamicResource TextMuteBrush}" FontSize="11" />
                            <Button Classes="icon" Click="OnFitClick" IsEnabled="{Binding HasImage}"
                                    ToolTip.Tip="{i18n:T '适合窗口（F）'}">
                                <ctl:Icon Data="{StaticResource IcoFit}" />
                            </Button>
                            <Button Classes="icon" Click="OnActualSizeClick" IsEnabled="{Binding HasImage}"
                                    ToolTip.Tip="{i18n:T '实际像素 100%（Ctrl+1）'}">
                                <ctl:Icon Data="{StaticResource IcoActual}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="10" ClipToBounds="True" Background="{DynamicResource ViewerBrush}">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <!-- Copy/paste of the frame's parameters leads the menu: it is the
                                 one thing here you reach for mid-edit. Ctrl+C / Ctrl+V do
                                 whichever of the two the open panel is showing. -->
                            <MenuItem Header="{i18n:T '复制标定'}" Click="OnCopyCalClick">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoCopy}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{i18n:T '粘贴标定到本帧'}" Click="OnPasteCalToCurrentClick"
                                      IsEnabled="{Binding HasCalClipboard}">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoCheck}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{i18n:T '复制场景'}" Click="OnCopySceneClick" />
                            <MenuItem Header="{i18n:T '粘贴场景到本帧'}" Click="OnPasteSceneToCurrentClick"
                                      IsEnabled="{Binding HasSceneClipboard}" />
                            <!-- Which field groups a copy actually carries is decided here, so it
                                 belongs beside the copy commands rather than only in 编辑. -->
                            <MenuItem Header="{i18n:T '选择同步项…'}" Click="OnSyncOptionsClick" />
                            <Separator />
                            <MenuItem Header="{i18n:T '适合窗口'}" InputGesture="F" Click="OnFitClick">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoFit}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{i18n:T '实际像素 100%（Ctrl+1）'}" Click="OnActualSizeClick">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoActual}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{i18n:T '查看负片'}" InputGesture="N" Click="OnMenuViewNegClick">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoFilm}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{i18n:T '前后对比'}" InputGesture="K" Click="OnMenuCompareClick">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoCompare}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{i18n:T '裁切（拖框）'}" Click="OnCropClick">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource IcoCrop}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{i18n:T '清除裁切'}" Click="OnClearCropClick" />
                            <MenuItem Header="{i18n:T '旋转 / 翻转'}">
                                <MenuItem Header="{i18n:T '逆时针 90°'}" Click="OnRotateCcwClick">
                                    <MenuItem.Icon>
                                        <ctl:Icon Data="{StaticResource IcoRotateCcw}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{i18n:T '顺时针 90°'}" Click="OnRotateCwClick">
                                    <MenuItem.Icon>
                                        <ctl:Icon Data="{StaticResource IcoRotateCw}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{i18n:T '水平翻转'}" Click="OnFlipHClick">
                                    <MenuItem.Icon>
                                        <ctl:Icon Data="{StaticResource IcoFlipH}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{i18n:T '竖直翻转'}" Click="OnFlipVClick">
                                    <MenuItem.Icon>
                                        <ctl:Icon Data="{StaticResource IcoFlipV}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{i18n:T '拉线取水平'}" Click="OnStraightenHClick">
                                    <MenuItem.Icon>
                                        <ctl:Icon Data="{StaticResource IcoLevelH}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{i18n:T '拉线取垂直'}" Click="OnStraightenVClick">
                                    <MenuItem.Icon>
                                        <ctl:Icon Data="{StaticResource IcoLevelV}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{i18n:T '显示齿孔遮罩'}" ToggleType="CheckBox"
                                      IsChecked="{Binding ShowSprocketMask, Mode=TwoWay}" />
                            <MenuItem Header="{i18n:T '预览背景色'}" Name="BgMenu2">
                                <MenuItem Header="{i18n:T '白'}" Tag="#FFFFFF" ToggleType="Radio" GroupName="viewerbg2" Click="OnViewerBgClick" />
                                <MenuItem Header="{i18n:T '浅灰'}" Tag="#B4B4B4" ToggleType="Radio" GroupName="viewerbg2" Click="OnViewerBgClick" />
                                <MenuItem Header="{i18n:T '中灰（默认）'}" Tag="#5E5E5E" ToggleType="Radio" GroupName="viewerbg2" Click="OnViewerBgClick" />
                                <MenuItem Header="{i18n:T '18% 中性灰'}" Tag="#777777" ToggleType="Radio" GroupName="viewerbg2" Click="OnViewerBgClick" />
                                <MenuItem Header="{i18n:T '深灰'}" Tag="#323232" ToggleType="Radio" GroupName="viewerbg2" Click="OnViewerBgClick" />
                                <MenuItem Header="{i18n:T '黑'}" Tag="#0E0F11" ToggleType="Radio" GroupName="viewerbg2" Click="OnViewerBgClick" />
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid Name="ViewPort" PointerWheelChanged="OnViewportWheel">
                        <Grid Name="ZoomGrid" RenderTransformOrigin="0,0"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Image Name="PreviewImg" Source="{Binding PreviewImage}" Stretch="Uniform"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            <!-- Sharp patch: the visible slice re-rendered from the ORIGINAL
                                 pixels, laid over the (6x downsampled) preview. Positioned in
                                 code from the letterbox rect, so it rides the same zoom/pan
                                 transform as everything else in ZoomGrid. -->
                            <Canvas Name="PatchLayer" IsHitTestVisible="False">
                                <Image Name="PatchImg" Stretch="Fill" />
                            </Canvas>
                            <Image Source="{Binding SprocketMaskOverlay}" Stretch="Uniform"
                                   IsVisible="{Binding ShowSprocketMask}" IsHitTestVisible="False"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            <Canvas Name="Overlay" Background="Transparent"
                                    PointerPressed="OnOverlayPressed"
                                    PointerMoved="OnOverlayMoved"
                                    PointerReleased="OnOverlayReleased">
                                <Rectangle Name="SelRect" IsVisible="False"
                                           Stroke="#E6E9EC" StrokeThickness="1.5"
                                           StrokeDashArray="4,2" Fill="#22E6E9EC" />
                                <!-- Editable crop frame. Four dim bands rather than one
                                     even-odd path: the bands are plain rectangles the layout
                                     can position directly, and what is outside the crop wants
                                     to read as "excluded", not as a shape. Handles and stroke
                                     are re-sized by 1/zoom in code so they stay a constant size
                                     on screen — everything here lives inside ZoomGrid and would
                                     otherwise grow with the picture. -->
                                <Rectangle Name="CropDimT" IsVisible="False" Fill="#99101214" />
                                <Rectangle Name="CropDimB" IsVisible="False" Fill="#99101214" />
                                <Rectangle Name="CropDimL" IsVisible="False" Fill="#99101214" />
                                <Rectangle Name="CropDimR" IsVisible="False" Fill="#99101214" />
                                <Rectangle Name="CropFrame" IsVisible="False"
                                           Stroke="#E6E9EC" StrokeThickness="1.5" />
                                <!-- Thirds guides: a crop frame without them is a box; with them
                                     it is a composition tool. -->
                                <Line Name="CropV1" IsVisible="False" Stroke="#66E6E9EC" StrokeThickness="1" />
                                <Line Name="CropV2" IsVisible="False" Stroke="#66E6E9EC" StrokeThickness="1" />
                                <Line Name="CropH1" IsVisible="False" Stroke="#66E6E9EC" StrokeThickness="1" />
                                <Line Name="CropH2" IsVisible="False" Stroke="#66E6E9EC" StrokeThickness="1" />
                                <!-- Straighten reference line. Warm, not the neutral marquee grey:
                                     it is a transient guide laid over the picture, not a selection. -->
                                <Line Name="SelLine" IsVisible="False"
                                      Stroke="#FF5A50" StrokeThickness="2" />
                            </Canvas>
                        </Grid>
                        <!-- Banner + its dismiss button, side by side. The row itself must stay
                             hit-testable: hit-testing is inherited DOWNWARD and cannot be
                             re-enabled by a child, so a dead wrapper here would make the banner's
                             own 应用/取消 unclickable too. The row therefore has no Background
                             (nothing to hit between the children) and each child decides for
                             itself — the banner only in crop mode, the × always. -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                    Margin="0,10,0,0">
                            <Border Name="Banner" IsVisible="False" CornerRadius="8"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource ChromeBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    Padding="12,8" MaxWidth="620">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Name="BannerText" Text="" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextWrapping="Wrap" FontSize="12" MaxWidth="440" />
                                    <!-- Explicit buttons, not just the Enter/Esc shortcuts: after
                                         picking a preset the keyboard focus is still in the combo,
                                         so a hidden key is not a reliable way to apply a crop. -->
                                    <Button Name="CropApplyBtn" Content="{i18n:T '应用'}" Classes="primary"
                                            IsVisible="False" Click="OnCropApplyClick" />
                                    <Button Name="CropCancelBtn" Content="{i18n:T '取消'}"
                                            IsVisible="False" Click="OnCropCancelClick" />
                                </StackPanel>
                            </Border>
                            <!-- Dismisses the HINT, never the Apply/Cancel pair: a tall crop frame
                                 (a vertical strip, a 3:4) reaches up under this banner and the
                                 text is what covers the handles. -->
                            <Button Name="BannerCloseBtn" IsVisible="False" Classes="icon"
                                    Width="24" Height="24" MinHeight="24" VerticalAlignment="Top"
                                    IsHitTestVisible="True" Click="OnBannerCloseClick"
                                    CornerRadius="12"
                                    Background="{DynamicResource ChromeBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    ToolTip.Tip="{i18n:T '关闭提示'}">
                                <ctl:Icon Data="{StaticResource IcoClose}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bottom bar: output intent + the terminal action. 导出整卷/印样 hang off
                     the export button's flyout (and off 文件) instead of being three peers. -->
                <Border Grid.Row="2" Padding="8,5" Background="{DynamicResource ChromeBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{i18n:T '输出'}" Margin="2,0,8,0" />
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding OutputIntentIndex}" VerticalAlignment="Center"
                                  ToolTip.Tip="{i18n:T '基础 = sRGB gamma + 帧编辑；线性 = 跳过帧编辑与 sRGB（原始线性）'}">
                            <ComboBoxItem Content="{i18n:T '基础（sRGB）'}" />
                            <ComboBoxItem Content="{i18n:T '线性'}" />
                        </ComboBox>

                        <TextBlock Grid.Column="2" Classes="fieldLabel" Text="{i18n:T '软打样'}" Margin="16,0,8,0" />
                        <ComboBox Grid.Column="3" SelectedIndex="{Binding SoftProofIndex}" VerticalAlignment="Center"
                                  ToolTip.Tip="{i18n:T '在屏幕上模拟导出到某个色彩空间的样子：超出该色域的颜色会按导出时的方式收进来。只影响预览，不影响导出文件。'}">
                            <ComboBoxItem Content="{i18n:T '关（直接看 sRGB）'}" />
                            <ComboBoxItem Content="Adobe RGB" />
                            <ComboBoxItem Content="Display P3" />
                            <ComboBoxItem Content="{i18n:T 'Kodak Endura Premier（相纸）'}" />
                            <ComboBoxItem Content="{i18n:T 'Kodak 2383（拷贝片）'}" />
                        </ComboBox>

                        <Button Grid.Column="5" Name="ExportButton" Classes="primary" Click="OnExportClick"
                                IsEnabled="{Binding HasImage}" CornerRadius="6,0,0,6" Padding="12,6"
                                ToolTip.Tip="{i18n:T '导出当前帧（Ctrl+E）'}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:Icon Data="{StaticResource IcoExport}" />
                                <TextBlock Text="{i18n:T '导出…'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="6" Name="ExportMoreButton" Classes="primary" IsEnabled="{Binding HasImage}"
                                CornerRadius="0,6,6,0" Padding="6,6" Margin="1,0,0,0"
                                ToolTip.Tip="{i18n:T '整卷导出 / 印样'}">
                            <ctl:Icon Data="{StaticResource IcoChevron}" Width="12" Height="12"
                                      RenderTransform="rotate(-90deg)" />
                            <Button.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedRight">
                                    <MenuItem Name="ExportRollButton" Header="{i18n:T '导出整卷…'}" Click="OnExportRollClick" />
                                    <MenuItem Name="ContactSheetButton" Header="{i18n:T '导出印样…'}" Click="OnContactSheetClick"
                                              ToolTip.Tip="{i18n:T '把整卷所有帧拼成一张网格印样图导出'}">
                                        <MenuItem.Icon>
                                            <ctl:Icon Data="{StaticResource IcoGrid}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="3" Width="1" Background="{DynamicResource BorderSoftBrush}" />

            <!-- Col 4 — histogram + FilmBase/SceneBase/备注 tabs -->
            <Grid Grid.Column="4" RowDefinitions="Auto,*" Background="{DynamicResource PanelBrush}">
                <Border Grid.Row="0" Padding="10,8,10,8" Background="{DynamicResource Panel2Brush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                    <ctl:HistogramView Data="{Binding Histogram}" Height="64" HorizontalAlignment="Stretch" />
                </Border>

                <!-- Which of these two is open decides what Ctrl+C / Ctrl+V act on: 整卷校准 →
                     Stage-1 标定, 帧编辑 → Stage-2 场景. -->
                <TabControl Name="PanelTabs" Grid.Row="1" Padding="0">
                    <!-- ══ 整卷校准（FilmBase · Stage 1） ═══════════════════════ -->
                    <TabItem Header="{i18n:T '整卷校准'}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="2" Margin="12,8,12,14">
                                <!-- 镜头校正 -->
                                <Expander Header="{i18n:T '镜头校正（手动）'}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="groupHint"
                                                   Text="{i18n:T '翻拍镜头的桶形/枕形畸变与四角压暗，反相后会让边框弯曲、四角泛白，此处补偿（不依赖镜头库）。'}" />
                                        <ctl:SliderRow Label="{i18n:T '畸变'}" Minimum="-0.5" Maximum="0.5" Decimals="3" Increment="0.005" DefaultValue="0" Value="{Binding DistortionK1}" />
                                        <ctl:SliderRow Label="{i18n:T '暗角'}" Minimum="-1" Maximum="2" Decimals="2" Increment="0.01" DefaultValue="0" Value="{Binding VignetteAmount}" />
                                        <ctl:SliderRow Label="{i18n:T '范围'}" Minimum="1" Maximum="6" Decimals="2" Increment="0.05" DefaultValue="2.5" Value="{Binding VignetteFalloff}" />
                                        <Separator Margin="0,8" />
                                        <TextBlock Classes="groupHint"
                                                   Text="{i18n:T 'LCC 平场校正：用平场参考图逐像素修正翻拍镜头的暗角/角落偏色（比公式暗角更准）。'}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Content="{i18n:T '载入 LCC 平场…'}" Click="OnLoadLccClick"
                                                    HorizontalAlignment="Stretch" Margin="0,0,6,0" IsEnabled="{Binding HasImage}" />
                                            <CheckBox Grid.Column="1" Content="{i18n:T '启用'}" IsChecked="{Binding LccEnabled}"
                                                      IsEnabled="{Binding LccAvailable}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Classes="groupHint" Text="{Binding LccStatus}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Expander>

                                <!-- 输入色彩表征 -->
                                <Expander Header="{i18n:T '输入色彩表征'}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="groupHint"
                                                   Text="{i18n:T '用相机自身的色彩矩阵把原生 RGB 映到 sRGB。相机 RAW 解码出来的是传感器自己的原色，此前管线直接当作 sRGB 使用——这正是 chroma_grade 当初要补的那一层，区别在于矩阵按色相各向异性地展开色度，而标量做不到。'}" />
                                        <CheckBox Content="{i18n:T '启用（新建卷默认开启）'}"
                                                  IsChecked="{Binding CharacteriseInput}" IsEnabled="{Binding HasImage}" />
                                        <TextBlock Classes="groupHint" Text="{Binding InputCharacterisationStatus}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Expander>

                                <!-- 片基去色罩 -->
                                <Expander Header="{i18n:T '片基去色罩（T_base / D_max）'}" IsExpanded="True">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="groupHint" Text="{Binding FilmBaseText}"
                                                   Foreground="{DynamicResource WarnBrush}" />
                                        <Expander Header="{i18n:T '片基透射率 T_base'}">
                                            <StackPanel Spacing="1">
                                                <ctl:SliderRow Label="R" Minimum="0.001" Maximum="2" Decimals="3" Increment="0.001" DefaultValue="0.82" Value="{Binding TBaseR}" />
                                                <ctl:SliderRow Label="G" Minimum="0.001" Maximum="2" Decimals="3" Increment="0.001" DefaultValue="0.51" Value="{Binding TBaseG}" />
                                                <ctl:SliderRow Label="B" Minimum="0.001" Maximum="2" Decimals="3" Increment="0.001" DefaultValue="0.29" Value="{Binding TBaseB}" />
                                            </StackPanel>
                                        </Expander>
                                        <ctl:SliderRow Label="D_max" Minimum="0.5" Maximum="5" Decimals="2" Increment="0.05" DefaultValue="2.0" Value="{Binding DMax}" />
                                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                            <ToggleButton Name="FilmBaseBtn" Grid.Column="0" Classes="sampling" Margin="0,0,3,0"
                                                          Click="OnSampleFilmBaseClick" IsEnabled="{Binding HasImage}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ctl:Icon Data="{StaticResource IcoMarquee}" />
                                                    <TextBlock Text="{i18n:T '框选片基'}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <ToggleButton Name="DMaxBtn" Grid.Column="1" Classes="sampling" Margin="3,0,0,0"
                                                          Click="OnSampleDMaxClick" IsEnabled="{Binding HasImage}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ctl:Icon Data="{StaticResource IcoMarquee}" />
                                                    <TextBlock Text="{i18n:T '框选 D_max'}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                        </Grid>
                                        <Button HorizontalAlignment="Stretch" Margin="0,3,0,0"
                                                Click="OnAutoDMaxClick" IsEnabled="{Binding HasImage}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ctl:Icon Data="{StaticResource IcoWand}" />
                                                <TextBlock Text="{i18n:T '自动检测 D_max'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <ctl:SliderRow Grid.Column="0" Label="{i18n:T '偏移'}" Minimum="-3" Maximum="3" Decimals="2" Increment="0.05" DefaultValue="0" Value="{Binding ScanEv}" />
                                            <ToggleButton Name="ScanEvBtn" Grid.Column="1" Classes="sampling icon" Margin="6,0,0,0"
                                                          Click="OnSampleScanEvClick" IsEnabled="{Binding HasImage}"
                                                          ToolTip.Tip="{i18n:T '框选一块应为纯片基的区域，自动校正零点'}">
                                                <ctl:Icon Data="{StaticResource IcoMarquee}" />
                                            </ToggleButton>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- 白平衡 WB -->
                                <Expander Header="{i18n:T '白平衡 WB'}" IsExpanded="True">
                                    <StackPanel Spacing="2">
                                        <Expander Header="{i18n:T '暗部 WB offset（加性）'}">
                                            <StackPanel Spacing="1">
                                                <ctl:SliderRow Label="R" Minimum="-2" Maximum="2" Decimals="3" Increment="0.001" DefaultValue="0" Value="{Binding WbOffR}" />
                                                <ctl:SliderRow Label="G" Minimum="-2" Maximum="2" Decimals="3" Increment="0.001" DefaultValue="0" Value="{Binding WbOffG}" />
                                                <ctl:SliderRow Label="B" Minimum="-2" Maximum="2" Decimals="3" Increment="0.001" DefaultValue="0" Value="{Binding WbOffB}" />
                                            </StackPanel>
                                        </Expander>
                                        <ToggleButton Name="WbOffsetBtn" Classes="sampling"
                                                      Click="OnSampleShadowClick" IsEnabled="{Binding HasImage}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ctl:Icon Data="{StaticResource IcoMarquee}" />
                                                <TextBlock Text="{i18n:T '框选暗部 WB'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <Expander Header="{i18n:T '亮部 WB high（乘性）'}" Margin="0,6,0,0">
                                            <StackPanel Spacing="1">
                                                <ctl:SliderRow Label="R" Minimum="0.1" Maximum="4" Decimals="3" Increment="0.001" DefaultValue="1" Value="{Binding WbHighR}" />
                                                <ctl:SliderRow Label="G" Minimum="0.1" Maximum="4" Decimals="3" Increment="0.001" DefaultValue="1" Value="{Binding WbHighG}" />
                                                <ctl:SliderRow Label="B" Minimum="0.1" Maximum="4" Decimals="3" Increment="0.001" DefaultValue="1" Value="{Binding WbHighB}" />
                                            </StackPanel>
                                        </Expander>
                                        <Grid ColumnDefinitions="*,*">
                                            <ToggleButton Name="WbHighBtn" Grid.Column="0" Classes="sampling" Margin="0,0,3,0"
                                                          Click="OnSampleHighlightWbClick" IsEnabled="{Binding HasImage}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ctl:Icon Data="{StaticResource IcoMarquee}" />
                                                    <TextBlock Text="{i18n:T '框选亮部'}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <Button Grid.Column="1" Margin="3,0,0,0" HorizontalAlignment="Stretch"
                                                    Click="OnAutoWbHighClick" IsEnabled="{Binding HasImage}"
                                                    ToolTip.Tip="{i18n:T '把画面最亮点当作纯白来解白平衡'}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ctl:Icon Data="{StaticResource IcoWand}" />
                                                    <TextBlock Text="{i18n:T '最亮点=白'}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Button Click="OnAutoWbAiClick" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                                IsEnabled="{Binding HasImage}"
                                                ToolTip.Tip="{i18n:T 'Deep-WB 神经网络推断白平衡（不需画面中有中性物）。建议先裁掉齿孔/片边。'}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ctl:Icon Data="{StaticResource IcoWand}" />
                                                <TextBlock Text="{i18n:T '智能白平衡（Beta·请先裁切）'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Expander>

                                <!-- 反差 -->
                                <Expander Header="{i18n:T '反差（相纸号数）'}" IsExpanded="True">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="groupHint"
                                                   Text="{i18n:T '彩色负片本身低反差（为暗房放大设计）。反差 = 数字版相纸号数，补偿这一压缩。'}" />
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Classes="fieldLabel" MinWidth="44" Text="{i18n:T '反差'}" />
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding GradePresetIndex}">
                                                <ComboBoxItem Content="{i18n:T '软 — 0–1 号纸'}" />
                                                <ComboBoxItem Content="{i18n:T '标准 — 2–3 号纸'}" />
                                                <ComboBoxItem Content="{i18n:T '硬 — 4–5 号纸'}" />
                                                <ComboBoxItem Content="{i18n:T '手动…'}" />
                                            </ComboBox>
                                        </Grid>
                                        <StackPanel Spacing="1" IsVisible="{Binding IsManualGrade}">
                                            <ctl:SliderRow Label="grade" Minimum="0.1" Maximum="3" Decimals="2" Increment="0.01" DefaultValue="1.65" Value="{Binding Grade}" />
                                            <ctl:SliderRow Label="pivot" Minimum="-2" Maximum="2" Decimals="2" Increment="0.01" DefaultValue="0.9" Value="{Binding Pivot}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <!-- 齿孔遮罩 -->
                                <Expander Header="{i18n:T '齿孔遮罩'}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="groupHint"
                                                   Text="{i18n:T '把齿孔/灯板等过亮区域（绝对亮度 &gt; 阈值）标记为遮罩，反相后填白。'}" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <CheckBox Content="{i18n:T '启用齿孔遮罩'}" IsChecked="{Binding SprocketEnabled}" IsEnabled="{Binding HasImage}" />
                                            <CheckBox Content="{i18n:T '显示遮罩'}" IsChecked="{Binding ShowSprocketMask}" IsEnabled="{Binding HasImage}" />
                                        </StackPanel>
                                        <ctl:SliderRow Label="{i18n:T '阈值'}" Minimum="0.05" Maximum="1.0" Decimals="3" Increment="0.005" DefaultValue="0.9" Value="{Binding SprocketThreshold}" />
                                    </StackPanel>
                                </Expander>

                                <!-- 几何 / 裁切 -->
                                <Expander Header="{i18n:T '几何 / 裁切'}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Classes="icon" Click="OnRotateCcwClick" IsEnabled="{Binding HasImage}"
                                                    AutomationProperties.Name="{i18n:T '逆时针 90°'}"
                                                    ToolTip.Tip="{i18n:T '逆时针 90°'}">
                                                <ctl:Icon Data="{StaticResource IcoRotateCcw}" />
                                            </Button>
                                            <Button Classes="icon" Click="OnRotateCwClick" IsEnabled="{Binding HasImage}"
                                                    AutomationProperties.Name="{i18n:T '顺时针 90°'}"
                                                    ToolTip.Tip="{i18n:T '顺时针 90°'}">
                                                <ctl:Icon Data="{StaticResource IcoRotateCw}" />
                                            </Button>
                                            <Button Classes="icon" Click="OnFlipHClick" IsEnabled="{Binding HasImage}"
                                                    AutomationProperties.Name="{i18n:T '水平翻转'}"
                                                    ToolTip.Tip="{i18n:T '水平翻转'}">
                                                <ctl:Icon Data="{StaticResource IcoFlipH}" />
                                            </Button>
                                            <Button Classes="icon" Click="OnFlipVClick" IsEnabled="{Binding HasImage}"
                                                    AutomationProperties.Name="{i18n:T '竖直翻转'}"
                                                    ToolTip.Tip="{i18n:T '竖直翻转'}">
                                                <ctl:Icon Data="{StaticResource IcoFlipV}" />
                                            </Button>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Classes="fieldLabel" MinWidth="44" Text="{i18n:T '预设'}" />
                                            <ComboBox Grid.Column="1" Name="CropPresetCombo" HorizontalAlignment="Stretch"
                                                      SelectedIndex="0" SelectionChanged="OnCropPresetChanged"
                                                      ToolTip.Tip="{i18n:T '选择后裁切框以此比例居中显示，拖框时保持该比例'}">
                                                <ComboBoxItem Content="{i18n:T '自由'}" />
                                                <ComboBoxItem Content="{i18n:T '135 全幅 — 内容 (3:2)'}" />
                                                <ComboBoxItem Content="{i18n:T '135 全幅 — 含边框 (37:35)'}" />
                                                <ComboBoxItem Content="{i18n:T '半格 — 内容 (3:4)'}" />
                                                <ComboBoxItem Content="{i18n:T 'XPan 全幅 (65:24)'}" />
                                                <ComboBoxItem Content="{i18n:T '645 — 内容 (4:3)'}" />
                                                <ComboBoxItem Content="{i18n:T '6×6 — 内容 (1:1)'}" />
                                                <ComboBoxItem Content="{i18n:T '6×7 — 内容 (7:6)'}" />
                                                <ComboBoxItem Content="{i18n:T '6×9 — 内容 (3:2)'}" />
                                                <ComboBoxItem Content="{i18n:T '6×12 全景 (2:1)'}" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ToggleButton Name="CropBtn" Grid.Column="0" Classes="sampling"
                                                          Click="OnCropClick" IsEnabled="{Binding HasImage}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ctl:Icon Data="{StaticResource IcoCrop}" />
                                                    <TextBlock Text="{i18n:T '裁切（拖框）'}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <Button Grid.Column="1" Content="{i18n:T '清除'}" Click="OnClearCropClick"
                                                    Margin="6,0,0,0" IsEnabled="{Binding HasImage}" />
                                        </Grid>
                                        <ctl:SliderRow Label="{i18n:T '拉直'}" Minimum="-15" Maximum="15" Decimals="1" Increment="0.5" DefaultValue="0" Value="{Binding Rotation}" />
                                        <Grid ColumnDefinitions="*,*">
                                            <ToggleButton Name="StraightenHBtn" Grid.Column="0" Classes="sampling"
                                                          Click="OnStraightenHClick" IsEnabled="{Binding HasImage}"
                                                          ToolTip.Tip="{i18n:T '在预览上拖一条『应当水平』的参考线（如地平线），松开即转正'}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ctl:Icon Data="{StaticResource IcoLevelH}" />
                                                    <TextBlock Text="{i18n:T '取水平'}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <ToggleButton Name="StraightenVBtn" Grid.Column="1" Classes="sampling"
                                                          Margin="6,0,0,0"
                                                          Click="OnStraightenVClick" IsEnabled="{Binding HasImage}"
                                                          ToolTip.Tip="{i18n:T '在预览上拖一条『应当垂直』的参考线（如门框、旗杆），松开即转正'}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ctl:Icon Data="{StaticResource IcoLevelV}" />
                                                    <TextBlock Text="{i18n:T '取垂直'}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- Broadcast. 复制 / 应用到勾选帧 / 同步项 moved to 编辑 菜单
                                     and the film-strip right-click; only the roll-wide action
                                     (the one this whole tab exists for) stays on-screen. -->
                                <Button Click="OnApplyCalToRollClick" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                        IsEnabled="{Binding HasImage}"
                                        ToolTip.Tip="{i18n:T '把当前帧的标定（按同步项）写入本卷所有其他帧。复制/粘贴到勾选帧见 编辑 菜单或胶片条右键。'}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ctl:Icon Data="{StaticResource IcoCheck}" />
                                        <TextBlock Text="{i18n:T '应用标定到整卷'}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ 帧编辑（SceneBase · Stage 2） ═══════════════════════ -->
                    <TabItem Header="{i18n:T '帧编辑'}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="2" Margin="12,8,12,14">
                                <Expander Header="{i18n:T '色偏修正（白平衡）'}" IsExpanded="True">
                                    <StackPanel Spacing="2">
                                        <ToggleButton Name="GreyPointBtn" Classes="sampling"
                                                      Click="OnGreyPointClick" IsEnabled="{Binding HasImage}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ctl:Icon Data="{StaticResource IcoMarquee}" />
                                                <TextBlock Text="{i18n:T '灰点（框选中性区）'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ctl:SliderRow Label="{i18n:T '色温'}" Minimum="-250" Maximum="250" Decimals="0" Increment="1" DefaultValue="0" Value="{Binding Temp}" />
                                        <ctl:SliderRow Label="{i18n:T '色调'}" Minimum="-250" Maximum="250" Decimals="0" Increment="1" DefaultValue="0" Value="{Binding Tint}" />
                                    </StackPanel>
                                </Expander>

                                <ctl:SliderRow Label="{i18n:T '曝光'}" Minimum="-3" Maximum="3" Decimals="2" Increment="0.1" DefaultValue="0" Value="{Binding ExposureEv}" />

                                <Expander Header="{i18n:T '色调（黑场 · 阴影 · 高光 · 白场）'}" IsExpanded="True">
                                    <StackPanel Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ctl:SliderRow Grid.Column="0" Label="{i18n:T '黑场'}" Minimum="-1" Maximum="1" Decimals="2" Increment="0.01" DefaultValue="0" Value="{Binding Black}" />
                                            <ToggleButton Name="BlackBtn" Grid.Column="1" Classes="sampling icon" Margin="6,0,0,0"
                                                          Click="OnSampleBlackClick" IsEnabled="{Binding HasImage}"
                                                          ToolTip.Tip="{i18n:T '框选最暗有效区设为黑场端点'}">
                                                <ctl:Icon Data="{StaticResource IcoMarquee}" />
                                            </ToggleButton>
                                        </Grid>
                                        <ctl:SliderRow Label="{i18n:T '阴影'}" Minimum="-1" Maximum="1" Decimals="2" Increment="0.01" DefaultValue="0" Value="{Binding Shadows}" />
                                        <ctl:SliderRow Label="{i18n:T '高光'}" Minimum="-1" Maximum="1" Decimals="2" Increment="0.01" DefaultValue="0" Value="{Binding Highlights}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ctl:SliderRow Grid.Column="0" Label="{i18n:T '白场'}" Minimum="-1" Maximum="1" Decimals="2" Increment="0.01" DefaultValue="0" Value="{Binding White}" />
                                            <ToggleButton Name="WhiteBtn" Grid.Column="1" Classes="sampling icon" Margin="6,0,0,0"
                                                          Click="OnSampleWhiteClick" IsEnabled="{Binding HasImage}"
                                                          ToolTip.Tip="{i18n:T '框选最亮有效区设为白场端点'}">
                                                <ctl:Icon Data="{StaticResource IcoMarquee}" />
                                            </ToggleButton>
                                        </Grid>
                                        <Button HorizontalAlignment="Stretch" Margin="0,5,0,0"
                                                Click="OnAutoLevelsClick" IsEnabled="{Binding HasImage}"
                                                ToolTip.Tip="{i18n:T '按全图分位自动设定黑场/白场端点'}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ctl:Icon Data="{StaticResource IcoWand}" />
                                                <TextBlock Text="{i18n:T '自动色阶（0.1% / 99.9%）'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Expander>

                                <ctl:SliderRow Label="{i18n:T '反差'}" Minimum="-1" Maximum="1" Decimals="2" Increment="0.01" DefaultValue="0" Value="{Binding Contrast}" />
                                <ctl:SliderRow Label="{i18n:T '饱和度'}" Minimum="-1" Maximum="1" Decimals="2" Increment="0.01" DefaultValue="0" Value="{Binding Saturation}" />

                                <Expander Header="{i18n:T '色调曲线'}">
                                    <ctl:CurveEditor Name="Curves" />
                                </Expander>

                                <Button Click="OnApplySceneToRollClick" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                        IsEnabled="{Binding HasImage}"
                                        ToolTip.Tip="{i18n:T '把当前帧的场景调整（白平衡/曝光/影调/曲线）写入本卷所有其他帧。复制/粘贴到勾选帧见 编辑 菜单或胶片条右键。'}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ctl:Icon Data="{StaticResource IcoCheck}" />
                                        <TextBlock Text="{i18n:T '应用场景到整卷'}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 卷注释 used to be a third tab here. The fields moved into the 印样 dialog
                         (文件 → 导出印样…) when they stopped feeding EXIF and started feeding the
                         identification strip burned onto the sheet — you want to be typing them
                         while looking at the roll they label, not in a side panel. -->
                </TabControl>
            </Grid>
        </Grid>

        </Panel>
    </DockPanel>
</Window>
