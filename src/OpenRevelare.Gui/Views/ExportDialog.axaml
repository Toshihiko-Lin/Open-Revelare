<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:OpenRevelare.Gui.Markup"
        x:Class="OpenRevelare.Gui.Views.ExportDialog"
        Width="600" MinWidth="460" MinHeight="360" SizeToContent="Height" MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Title="{i18n:T '导出选项'}">
    <!-- Labels share an 86 px column, including English. Body scrolls; actions stay visible. -->
    <Window.Styles>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
            <Setter Property="Padding" Value="12,10,12,11" />
        </Style>
        <Style Selector="TextBlock.sectionHead">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <!-- 行距由所在 StackPanel 的 Spacing 一处决定，所以把 groupHint 自带的下边距
             去掉：两者叠加会让「最后一行是提示」的节比别的节多出 6 px。 -->
        <Style Selector="TextBlock.groupHint">
            <Setter Property="Margin" Value="0" />
        </Style>
        <!-- Keep RadioButton group/keyboard semantics while making each entire card selectable. -->
        <Style Selector="RadioButton.exportFormat">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="FormatCard" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMd}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.exportFormat:pointerover">
            <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
        </Style>
        <Style Selector="RadioButton.exportFormat:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="RadioButton.exportFormat:focus-visible /template/ Border#FormatCard">
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBlock.formatTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
        </Style>
        <Style Selector="TextBlock.formatDetail">
            <Setter Property="FontSize" Value="{DynamicResource FontXxs}" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <SplitView Name="FilmInfoDrawer" DisplayMode="Overlay" PanePlacement="Right"
               OpenPaneLength="430" CompactPaneLength="0" IsPaneOpen="False">
        <SplitView.Pane>
            <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1,0,0,0" Padding="16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <TextBlock Classes="sectionHead" Text="{i18n:T '胶片拍摄信息'}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{i18n:T '关闭'}" Click="OnCloseFilmInfoClick" />
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Name="FilmInfoPaneContent" Spacing="10">
                                <StackPanel Name="FilmEditorGroup" Spacing="10">
                                    <StackPanel Name="FilmFrameNavigator" Spacing="6" IsVisible="False">
                                        <Image Name="FilmFramePreview" Height="110" Stretch="Uniform" />
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Button Name="PreviousFilmFrameBtn" Content="←" Click="OnPreviousFilmFrame" ToolTip.Tip="{i18n:T '上一张'}" />
                                            <TextBlock Name="FilmFrameLabel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" />
                                            <Button Name="NextFilmFrameBtn" Grid.Column="2" Content="→" Click="OnNextFilmFrame" ToolTip.Tip="{i18n:T '下一张'}" />
                                        </Grid>
                                        <Grid Name="FilmDeviceSyncRow" ColumnDefinitions="*,12,*">
                                            <CheckBox Name="CameraSyncChk" Content="{i18n:T '机身同步整卷'}" IsChecked="True" IsCheckedChanged="OnDeviceSyncChanged" />
                                            <CheckBox Name="LensSyncChk" Grid.Column="2" Content="{i18n:T '镜头同步整卷'}" IsChecked="True" IsCheckedChanged="OnDeviceSyncChanged" />
                                        </Grid>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,12,*">
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Spacing="6">
                                                <TextBlock Classes="sectionHead" Text="{i18n:T '胶片机身'}"/>
                                                <ComboBox Name="CameraLibraryBox" HorizontalAlignment="Stretch"
                                                          SelectionChanged="OnCameraSelected"/>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="formatDetail" Text="{i18n:T '品牌'}"/>
                                                    <TextBox Name="CameraMakeBox" TextChanged="OnCameraEdited"/>
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="formatDetail" Text="{i18n:T '型号'}"/>
                                                    <TextBox Name="CameraModelBox" TextChanged="OnCameraEdited"/>
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="formatDetail" Text="{i18n:T '序列号（可选）'}"/>
                                                    <TextBox Name="CameraSerialBox" TextChanged="OnCameraEdited"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Spacing="6">
                                                <TextBlock Classes="sectionHead" Text="{i18n:T '胶片镜头'}"/>
                                                <ComboBox Name="LensLibraryBox" HorizontalAlignment="Stretch"
                                                          SelectionChanged="OnLensSelected"/>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="formatDetail" Text="{i18n:T '品牌'}"/>
                                                    <TextBox Name="LensMakeBox" TextChanged="OnLensEdited"/>
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="formatDetail" Text="{i18n:T '型号'}"/>
                                                    <TextBox Name="LensModelBox" TextChanged="OnLensEdited"/>
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="formatDetail" Text="{i18n:T '序列号（可选）'}"/>
                                                    <TextBox Name="LensSerialBox" TextChanged="OnLensEdited"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Classes="groupHint" Text="{i18n:T '确认导出后记住机身和镜头；曝光与日期不记忆。'}"/>
                                    <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,8,Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="formatDetail" Text="{i18n:T '胶片 ISO'}"/>
                                                <TextBox Name="FilmIsoBox" Watermark="400" TextChanged="OnFilmFieldChanged"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="formatDetail" Text="{i18n:T '光圈'}"/>
                                                <TextBox Name="FilmApertureBox" Watermark="2.8" TextChanged="OnFilmFieldChanged"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="formatDetail" Text="{i18n:T '快门（秒）'}"/>
                                                <TextBox Name="FilmShutterBox" Watermark="1/125" TextChanged="OnFilmFieldChanged"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="formatDetail" Text="{i18n:T '焦距（mm）'}"/>
                                                <TextBox Name="FilmFocalBox" Watermark="50" TextChanged="OnFilmFieldChanged"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="formatDetail" Text="{i18n:T '胶片拍摄时间（可选）'}"/>
                                        <TextBox Name="FilmDateBox" Watermark="YYYY-MM-DD HH:mm:ss" TextChanged="OnFilmFieldChanged"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,12,*">
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="formatDetail" Text="{i18n:T '作者'}"/>
                                                <TextBox Name="FilmArtistBox" TextChanged="OnFilmFieldChanged"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="formatDetail" Text="{i18n:T '版权'}"/>
                                                <TextBox Name="FilmCopyrightBox" TextChanged="OnFilmFieldChanged"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <CheckBox Name="FilmInfoChk" Content="{i18n:T '导出时写入胶片拍摄信息'}" IsCheckedChanged="OnAnyChanged"/>
                                <TextBlock Classes="groupHint" Text="{i18n:T '未填项目留空，不沿用翻拍参数。曝光、日期等参数按张填写；取消同步可单独修改机身或镜头。'}"/>
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="formatDetail" Text="{i18n:T '数字化来源（当前帧）'}"/>
                                    <TextBlock Name="SourceExifSummaryLbl" Classes="groupHint" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Name="ExifErrorLbl" TextWrapping="Wrap" FontWeight="SemiBold" IsVisible="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </SplitView.Pane>
        <SplitView.Content>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
            <!-- 结论条：这些选项最后写出的是什么文件。也是被隐藏的那些参数的唯一去处。 -->
            <Border Classes="section" Padding="12,8">
                <Grid ColumnDefinitions="86,*">
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{i18n:T '将写出'}"
                               VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Name="SummaryLbl" TextWrapping="Wrap"
                               FontSize="{DynamicResource FontXs}" />
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <!-- IsCancel / IsDefault：Esc 退出，Enter 确认，同 InfoDialog 与 PromptDialog。 -->
                <Button Content="{i18n:T '取消'}" IsCancel="True" Click="OnCancelClick" />
                <Button Classes="primary" Name="OkBtn" IsDefault="True"
                        Content="{i18n:T '选择位置 →'}" Click="OnAcceptClick" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Name="OptionsScroll" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" Margin="0,0,6,0">
                <!-- The roll owns SDR/HDR. Cards describe its current delivery; they select
                     only the container. Encoding and colour stay together below that choice. -->
                <Border Classes="section">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="sectionHead" Text="{i18n:T '格式'}" />
                        <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto"
                              Margin="0,2,0,4">
                            <RadioButton Grid.Row="0" Grid.Column="0" Name="FmtJpeg" Classes="exportFormat"
                                         AutomationProperties.Name="JPEG"
                                         GroupName="fmt" IsCheckedChanged="OnFormatChanged">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="formatTitle" Text="JPEG" />
                                    <TextBlock Classes="formatDetail" Name="JpegFormatDetail" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Grid.Row="0" Grid.Column="2" Name="FmtHeic" Classes="exportFormat"
                                         AutomationProperties.Name="HEIC"
                                         GroupName="fmt" IsCheckedChanged="OnFormatChanged">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="formatTitle" Text="HEIC" />
                                    <TextBlock Classes="formatDetail" Name="HeicFormatDetail" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Grid.Row="2" Grid.Column="0" Name="FmtTiff" Classes="exportFormat"
                                         AutomationProperties.Name="TIFF"
                                         GroupName="fmt" IsCheckedChanged="OnFormatChanged">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="formatTitle" Text="TIFF" />
                                    <TextBlock Classes="formatDetail" Name="TiffFormatDetail" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Grid.Row="2" Grid.Column="2" Name="FmtDng" Classes="exportFormat"
                                         AutomationProperties.Name="{i18n:T '线性 DNG'}"
                                         GroupName="fmt" IsCheckedChanged="OnFormatChanged">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="formatTitle" Text="{i18n:T '线性 DNG'}" />
                                    <TextBlock Classes="formatDetail" Text="{i18n:T '16-bit · 外部调色'}" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                        <TextBlock Classes="groupHint" Name="FormatHint" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <StackPanel Name="TiffGroup" Spacing="6">
                            <Grid ColumnDefinitions="86,*">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{i18n:T '压缩'}" />
                                <ComboBox Grid.Column="1" Name="CompressBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnAnyChanged">
                                    <ComboBoxItem Content="{i18n:T 'LZW（无损，推荐）'}" />
                                    <ComboBoxItem Content="{i18n:T 'Deflate（无损，文件更小、更慢）'}" />
                                    <ComboBoxItem Content="{i18n:T '不压缩（最快、最大）'}" />
                                </ComboBox>
                            </Grid>
                            <!-- 场景线性是 TIFF 的决定 —— 它把文件变成 32-bit float 母版 ——
                                 所以它归在格式里，不在色彩里。 -->
                            <Grid ColumnDefinitions="86,*">
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <CheckBox Name="LinearChk"
                                              Content="{i18n:T '场景线性 ACEScg（32-bit float，不含帧编辑）'}"
                                              IsCheckedChanged="OnAnyChanged" />
                                    <TextBlock Classes="groupHint"
                                               Text="{i18n:T '用于外部调色，不做输出锐化；普通查看器中可能偏暗。'}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Name="JpegGroup" Spacing="6">
                            <Grid Name="JpegQualityRow" ColumnDefinitions="86,*">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{i18n:T '品质'}" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                    <Slider Grid.Column="0" Name="QualitySlider" Minimum="40" Maximum="100"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="OnQualityChanged" />
                                    <!-- readout：滑块在动时读数不能跟着抖，见 App.axaml 的说明。 -->
                                    <TextBlock Grid.Column="1" Name="QualityLbl" Classes="readout"
                                               MinWidth="26" Margin="10,0,0,0"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>
                            <Grid Name="HeicHdrRow" ColumnDefinitions="86,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="HDR" />
                                <ComboBox Grid.Column="1" Name="HeicHdrBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnAnyChanged">
                                    <ComboBoxItem Content="{i18n:T '单层 HDR（PQ）'}" />
                                    <ComboBoxItem Content="{i18n:T 'Adaptive HDR（标准增益图）'}" />
                                </ComboBox>
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="groupHint" Margin="0,3,0,0"
                                           Text="{i18n:T '单层 HDR 直接以 PQ 编码，不依赖增益图，通常体积较小；需要支持 PQ HDR HEIC 的查看器。Adaptive HDR 包含 SDR 主图与标准增益图，通常体积较大；HDR 支持取决于系统和应用。'}" />
                            </Grid>
                            <Grid Name="HeicQualityRow" ColumnDefinitions="86,*">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{i18n:T '品质'}" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                    <Slider Grid.Column="0" Name="HeicQualitySlider" Minimum="40" Maximum="100"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="OnQualityChanged" />
                                    <TextBlock Grid.Column="1" Name="HeicQualityLbl" Classes="readout"
                                               MinWidth="26" Margin="10,0,0,0"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>
                            <Grid ColumnDefinitions="86,*">
                                <CheckBox Grid.Column="1" Name="SizeLimitChk"
                                          Content="{i18n:T '限制文件大小'}" IsCheckedChanged="OnAnyChanged" />
                            </Grid>
                            <!-- 带提示的行做成两排：标签只跟第一排的控件对齐，不去跟整块居中。 -->
                            <Grid Name="SizeLimitRow" ColumnDefinitions="86,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel"
                                           Text="{i18n:T '上限'}" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <NumericUpDown Name="SizeLimitBox" Width="130"
                                                   Minimum="0.1" Maximum="1000" Increment="0.5"
                                                   FormatString="0.#" ValueChanged="OnAnyChanged" />
                                    <TextBlock Classes="fieldLabel" Text="MB" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="groupHint" Margin="0,3,0,0"
                                           Text="{i18n:T '先降品质（下限 40），仍超限再缩尺寸；结果在状态栏报告。'}" />
                            </Grid>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,6" />
                        <!-- 输出空间是报告，不是选择：它是渲染参数，在主窗口选定，文件继承屏上那个。 -->
                        <Grid Name="SpaceRow" ColumnDefinitions="86,*">
                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{i18n:T '空间'}"
                                       VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Name="ColorSpaceHint" TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontXs}" VerticalAlignment="Top" />
                        </Grid>

                        <!-- 只有 HDR 卷的增益图 JPEG 有基底可选；见 ExportOptions.HdrBaseSpace。 -->
                        <Grid Name="HdrBaseGroup" ColumnDefinitions="86,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="{i18n:T '基底'}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Name="HdrBaseBox"
                                      HorizontalAlignment="Stretch" SelectionChanged="OnAnyChanged">
                                    <ComboBoxItem Content="{i18n:T 'sRGB（通用）'}" />
                                    <ComboBoxItem Content="{i18n:T 'Display P3（宽色域）'}" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="groupHint" Margin="0,3,0,0"
                                       Text="{i18n:T '基底决定文件色域；完整母版用 TIFF。'}" />
                        </Grid>

                        <!-- 只在确实可选时出现：被强制嵌入的那几种文件没有决定可做，结论条会报告。 -->
                        <Grid Name="IccRow" ColumnDefinitions="86,*">
                            <StackPanel Grid.Column="1" Spacing="3">
                                <CheckBox Name="IccChk" Content="{i18n:T '嵌入 ICC 配置文件'}"
                                          IsCheckedChanged="OnIccChanged" />
                                <TextBlock Classes="groupHint"
                                           Text="{i18n:T 'sRGB 可不嵌入：看图软件默认按 sRGB 处理。'}" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ── 尺寸 ───────────────────────────────────────────── -->
                <Border Classes="section">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="sectionHead" Text="{i18n:T '尺寸'}" />
                        <Grid ColumnDefinitions="86,*">
                            <CheckBox Grid.Column="1" Name="DownsampleChk"
                                      Content="{i18n:T '缩放到指定长边'}" IsCheckedChanged="OnDownsampleToggled" />
                        </Grid>
                        <Grid Name="LongEdgeRow" ColumnDefinitions="86,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="{i18n:T '长边'}" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <NumericUpDown Name="LongEdgeBox" Width="130"
                                               Minimum="256" Maximum="20000" Increment="256"
                                               FormatString="0" ValueChanged="OnAnyChanged" />
                                <TextBlock Classes="fieldLabel" Text="px" />
                            </StackPanel>
                            <CheckBox Grid.Row="1" Grid.Column="1" Name="UpscaleChk" Margin="0,6,0,0"
                                      Content="{i18n:T '长边不足时也放大'}" IsCheckedChanged="OnAnyChanged" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="groupHint" Margin="0,3,0,0"
                                       Text="{i18n:T '保持比例；默认只缩小，勾选后允许放大。'}" />
                        </Grid>

                        <!-- 锐化归在尺寸里，不在格式里：它的量是按成品像素定的，就在缩放之后做。 -->
                        <Grid Name="SharpenRow" ColumnDefinitions="86,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="{i18n:T '锐化'}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Name="SharpenBox"
                                      HorizontalAlignment="Stretch" SelectionChanged="OnAnyChanged" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="groupHint" Margin="0,3,0,0"
                                       Text="{i18n:T '按导出尺寸锐化；颗粒也会增强。'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Capture and digitization are separate identities; choosing a film body
                     never borrows the copying camera's exposure or location. -->
                <Border Classes="section">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="sectionHead" Text="EXIF"/>
                        <CheckBox Name="KeepExifChk" Content="{i18n:T '保留源文件 EXIF／数字化来源'}" IsCheckedChanged="OnAnyChanged" ToolTip.Tip="{i18n:T '未填写胶片信息时沿用源 EXIF；填写后，源翻拍／扫描信息单独保存在 XMP 中。'}"/>
                        <Button Name="FilmInfoEntry" HorizontalAlignment="Left"
                                Content="{i18n:T '编辑胶片拍摄信息 →'}" Click="OnOpenFilmInfoClick" />
                    </StackPanel>
                </Border>

                <!-- ── 文件名 ───────────────────────────────────────────
                     选一个现成命名，底下一行给出这一卷第一张的实际文件名。花括号那套写法
                     不出现在这里：它精确但没法读，「{Roll}_{Seq}」要看见展开的结果才知道
                     是什么。写模板的入口留在「自定义…」里，选中它才露出输入框与字段表。 -->
                <Border Classes="section">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="sectionHead" Text="{i18n:T '文件名'}" />
                        <Grid ColumnDefinitions="86,*">
                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{i18n:T '命名'}" />
                            <ComboBox Grid.Column="1" Name="NamePresetBox" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnNamePresetChanged" />
                        </Grid>
                        <!-- 字段表由 code-behind 填：文本里带花括号，XAML 解析器会把它读成标记扩展。 -->
                        <Grid Name="CustomNameRow" ColumnDefinitions="86,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel"
                                       Text="{i18n:T '模板'}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Name="NameTemplateBox"
                                     TextChanged="OnTemplateChanged" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="groupHint" Margin="0,3,0,0"
                                       Name="NameTokensLbl" />
                        </Grid>
                        <Grid Name="PreviewRow" ColumnDefinitions="86,*">
                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{i18n:T '实例'}"
                                       VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Name="NamePreviewLbl" Classes="readout"
                                       TextWrapping="Wrap" VerticalAlignment="Top" />
                        </Grid>
                        <!-- 单张导出：这一节决定的是保存对话框预填的名字，说一句，否则这里的
                             选择看起来像是会直接落盘。 -->
                        <Grid Name="SingleNameHintRow" ColumnDefinitions="86,*">
                            <TextBlock Grid.Column="1" Classes="groupHint"
                                       Text="{i18n:T '保存对话框会预填这个名字，仍可修改。'}" />
                        </Grid>
                        <StackPanel Name="ConflictGroup" Spacing="6" Margin="0,6,0,0">
                            <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,0,0,6" />
                            <Grid ColumnDefinitions="86,*">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{i18n:T '重名时'}" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <WrapPanel Orientation="Horizontal">
                                        <RadioButton Name="ConflictUnique" GroupName="conflict"
                                                     Margin="0,0,16,4" Content="{i18n:T '另存为新名'}" IsCheckedChanged="OnAnyChanged" />
                                        <RadioButton Name="ConflictOverwrite" GroupName="conflict"
                                                     Margin="0,0,16,4" Content="{i18n:T '覆盖'}" IsCheckedChanged="OnAnyChanged" />
                                        <RadioButton Name="ConflictSkip" GroupName="conflict"
                                                     Margin="0,0,0,4" Content="{i18n:T '跳过该帧'}" IsCheckedChanged="OnAnyChanged" />
                                    </WrapPanel>
                                    <TextBlock Classes="groupHint"
                                               Text="{i18n:T '整卷批量写入，不逐个询问；同批次内重名一律另存。'}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
        </SplitView.Content>
    </SplitView>
</Window>
