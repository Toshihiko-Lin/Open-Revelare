<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:OpenRevelare.Gui.Markup"
        x:Class="OpenRevelare.Gui.Views.ImportDialog"
        Width="640" SizeToContent="Height" MinWidth="520" MinHeight="400" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}"
        Title="{i18n:T '新建项目 / 导入'}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
            <StackPanel Name="DestinationRow" Orientation="Horizontal" Spacing="16" IsVisible="False">
                <RadioButton Name="NewRollChoice" GroupName="destination" Content="{i18n:T '新建卷'}" IsChecked="True" />
                <RadioButton Name="CurrentRollChoice" GroupName="destination" Content="{i18n:T '添加到当前卷'}" IsCheckedChanged="OnDestinationChanged" />
            </StackPanel>
            <TextBlock Name="ReadyHint" Classes="groupHint" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{i18n:T '取消'}" IsCancel="True" Click="OnCancelClick" />
                <Button Name="OkBtn" Classes="primary" Content="{i18n:T '导入'}" IsDefault="True" Click="OnAcceptClick" IsEnabled="False" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <!-- ── 文件 ─────────────────────────────────────────── -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{i18n:T '底片文件 · 可拖入文件或文件夹'}" FontWeight="SemiBold"
                               ToolTip.Tip="{i18n:T '支持 RAW（ARW/NEF/CR2/DNG 等）与扫描仪 TIFF。多选 = 整卷。'}" />
                    <ListBox Name="FileList" Height="112" SelectionMode="Multiple"
                             Background="{DynamicResource Panel2Brush}" />
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="{i18n:T '添加文件…'}" Click="OnAddFiles" Margin="0,0,6,6" />
                        <Button Content="{i18n:T '添加文件夹…'}" Click="OnAddFolder" Margin="0,0,6,6" />
                        <Button Content="{i18n:T '移除选中'}" Click="OnRemoveSelected" Margin="0,0,6,6" />
                        <Button Content="{i18n:T '清空'}" Click="OnClear" Margin="0,0,6,6" />
                        <TextBlock Name="CountLbl" Text="{i18n:T '0 张'}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuteBrush}" Margin="6,0,0,0" />
                    </WrapPanel>
                </StackPanel>

                <StackPanel Name="ImportProcessingOptions" Spacing="12">
                    <Border Background="{DynamicResource Panel2Brush}" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{i18n:T '翻拍校正（相机 RAW）'}" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="84,*">
                                <TextBlock Text="{i18n:T '翻拍光源'}" VerticalAlignment="Center" Foreground="{DynamicResource TextMuteBrush}" />
                                <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton Name="SrcB" GroupName="src" Content="{i18n:T '白光'}" IsChecked="True" Margin="0,0,18,0"
                                                 ToolTip.Tip="{i18n:T '宽谱光源（白光）— Path B'}" />
                                    <RadioButton Name="SrcA" GroupName="src" Content="{i18n:T 'RGB 合成光'}"
                                                 Checked="OnSourceChanged" Unchecked="OnSourceChanged"
                                                 ToolTip.Tip="{i18n:T 'RGB LED 灯板翻拍：分别拍红 / 绿 / 蓝三张，加一张空白灯板 RAW，放在同一文件夹（自动识别）。据此解出通道串扰，还原更准确的原色。'}" />
                                </WrapPanel>
                            </Grid>
                            <StackPanel Name="CalRow" IsVisible="False" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Name="CalEdit" IsReadOnly="True" Margin="0,0,6,0"
                                             Watermark="{i18n:T '选择含 R/G/B 校正图的文件夹'}" />
                                    <Button Grid.Column="1" Content="{i18n:T '选择…'}" Click="OnPickCal" />
                                </Grid>
                                <TextBlock Name="CalDetect" Classes="groupHint" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Name="LccChk" Content="{i18n:T 'LCC 平场校正（可选）'}" IsCheckedChanged="OnLccToggled"
                                      ToolTip.Tip="{i18n:T '拍一张均匀光的平场参考图，逐像素/逐通道修正本翻拍镜头的暗角与角落偏色。'}" />
                            <Grid Name="LccRow" ColumnDefinitions="*,Auto" IsVisible="False">
                                <TextBox Name="LccEdit" IsReadOnly="True" Margin="0,0,6,0"
                                         Watermark="{i18n:T '均匀光的平场参考图（RAW 或 TIFF）'}" />
                                <Button Grid.Column="1" Content="{i18n:T '选择…'}" Click="OnPickLcc" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{i18n:T '导入处理'}" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*">
                            <CheckBox Name="SplitChk" Content="{i18n:T '扫描件多格分割'}"
                                      ToolTip.Tip="{i18n:T '扫描仪常把一整条底片扫成一张图。勾选后导入时先识别每条有几格，并弹窗让你确认分隔线。'}" />
                            <CheckBox Name="AutoInvertChk" Grid.Column="1" IsChecked="True"
                                      ToolTip.Tip="{i18n:T '分析整卷的片基与高光代理，统一标定端点；完成后刷新预览。'}">
                                <TextBlock Text="{i18n:T '导入后自动分析整卷（推荐）'}" TextWrapping="Wrap" />
                            </CheckBox>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
