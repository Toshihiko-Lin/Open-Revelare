<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenRevelare.Gui.Views.ImportDialog"
        Width="600" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Title="新建项目 / 导入">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,12,0,0">
            <Button Content="取消" Click="OnCancelClick" />
            <Button Name="OkBtn" Content="打开 →" Click="OnAcceptClick" IsEnabled="False" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="12">
                <!-- ── 文件 ─────────────────────────────────────────── -->
                <StackPanel Spacing="4">
                    <TextBlock Text="底片文件" FontWeight="SemiBold" />
                    <ListBox Name="FileList" Height="140" SelectionMode="Multiple"
                             Background="{DynamicResource Panel2Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="添加文件…" Click="OnAddFiles" />
                        <Button Content="添加文件夹…" Click="OnAddFolder" />
                        <Button Content="移除选中" Click="OnRemoveSelected" />
                        <Button Content="清空" Click="OnClear" />
                        <TextBlock Name="CountLbl" Text="0 张" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuteBrush}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Classes="groupHint" Text="支持 RAW（ARW/NEF/CR2/DNG 等）与扫描仪 TIFF。多选 = 整卷。" />
                </StackPanel>

                <!-- ── 卷信息 ───────────────────────────────────────────
                     Entered here because this is when you still remember it. Nothing in the
                     pipeline reads these; they print on the contact sheet and title the roll
                     in the catalog, and stay editable in the 印样 window afterwards.
                     ──────────────────────────────────────────────────── -->
                <StackPanel Spacing="4">
                    <TextBlock Text="卷信息（可选）" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="画幅" Margin="0,3,8,3" />
                        <AutoCompleteBox Grid.Row="0" Grid.Column="1" Name="FormatCombo" Margin="0,3,14,3"
                                         FilterMode="None" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="fieldLabel" Text="相机" Margin="0,3,8,3" />
                        <TextBox  Grid.Row="0" Grid.Column="3" Name="CameraEdit" Margin="0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="胶卷" Margin="0,3,8,3" />
                        <TextBox  Grid.Row="1" Grid.Column="1" Name="FilmEdit" Margin="0,3,14,3" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="fieldLabel" Text="卷号" Margin="0,3,8,3" />
                        <TextBox  Grid.Row="1" Grid.Column="3" Name="RollNoEdit" Margin="0,3" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="冲洗店" Margin="0,3,8,3" />
                        <TextBox  Grid.Row="2" Grid.Column="1" Name="LabEdit" Margin="0,3,14,3" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="fieldLabel" Text="日期" Margin="0,3,8,3" />
                        <TextBox  Grid.Row="2" Grid.Column="3" Name="DateEdit" Margin="0,3" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="fieldLabel" Text="地点" Margin="0,3,8,3" />
                        <TextBox  Grid.Row="3" Grid.Column="1" Name="LocationEdit" Margin="0,3,14,3" />
                    </Grid>
                    <TextBox Name="NoteEdit" AcceptsReturn="True" Height="52" TextWrapping="Wrap"
                             Watermark="备注" Margin="0,4,0,0" />
                    <TextBlock Classes="groupHint"
                               Text="印在印样上，不写入 EXIF；也是图库的筛选依据（胶卷 / 相机 / ISO / 冲洗店 / 工艺 / 地点 / 年份）。导入后仍可在图库「卷信息」里修改。" />
                </StackPanel>

                <!-- ── 翻拍光源 ─────────────────────────────────────── -->
                <StackPanel Spacing="4">
                    <TextBlock Text="翻拍光源（仅相机 RAW）" FontWeight="SemiBold" />
                    <RadioButton Name="SrcB" GroupName="src" Content="宽谱光源（白光）— Path B" IsChecked="True" />
                    <RadioButton Name="SrcA" GroupName="src" Content="窄谱光源（RGB 合成）— Path A，需校正图"
                                 Checked="OnSourceChanged" Unchecked="OnSourceChanged"
                                 ToolTip.Tip="RGB LED 灯板翻拍：分别拍纯红/绿/蓝光的三张空白灯板 RAW（放同一文件夹，自动识别），据此计算分光解耦矩阵，更精确还原色彩。" />
                    <StackPanel Name="CalRow" IsVisible="False" Spacing="4" Margin="20,2,0,0">
                        <TextBlock Text="校正图目录（含红/绿/蓝三张空白灯板 RAW）" Foreground="{DynamicResource TextMuteBrush}" FontSize="11" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Name="CalEdit" Grid.Column="0" IsReadOnly="True" Margin="0,0,6,0"
                                     Watermark="选择含 R/G/B 校正图的文件夹" />
                            <Button Grid.Column="1" Content="选择…" Click="OnPickCal" />
                        </Grid>
                        <TextBlock Name="CalDetect" Classes="groupHint" Text="" />
                    </StackPanel>
                </StackPanel>

                <!-- ── LCC 平场校正 ─────────────────────────────────── -->
                <StackPanel Spacing="4">
                    <TextBlock Text="LCC 平场校正（可选）" FontWeight="SemiBold" />
                    <CheckBox Name="LccChk" Content="启用 LCC 平场校正"
                              IsCheckedChanged="OnLccToggled"
                              ToolTip.Tip="拍一张均匀光的平场参考图，逐像素/逐通道修正本翻拍镜头的暗角与角落偏色。" />
                    <Grid Name="LccRow" ColumnDefinitions="*,Auto" IsVisible="False" Margin="20,2,0,0">
                        <TextBox Name="LccEdit" Grid.Column="0" IsReadOnly="True" Margin="0,0,6,0"
                                 Watermark="均匀光的平场参考图（RAW 或 TIFF）" />
                        <Button Grid.Column="1" Content="选择…" Click="OnPickLcc" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
