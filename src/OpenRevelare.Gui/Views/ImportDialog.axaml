<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:OpenRevelare.Gui.Markup"
        x:Class="OpenRevelare.Gui.Views.ImportDialog"
        Width="600" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Title="{i18n:T '新建项目 / 导入'}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,12,0,0">
            <Button Content="{i18n:T '取消'}" Click="OnCancelClick" />
            <Button Name="OkBtn" Content="{i18n:T '打开 →'}" Click="OnAcceptClick" IsEnabled="False" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="12">
                <!-- ── 文件 ─────────────────────────────────────────── -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{i18n:T '底片文件'}" FontWeight="SemiBold" />
                    <ListBox Name="FileList" Height="140" SelectionMode="Multiple"
                             Background="{DynamicResource Panel2Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="{i18n:T '添加文件…'}" Click="OnAddFiles" />
                        <Button Content="{i18n:T '添加文件夹…'}" Click="OnAddFolder" />
                        <Button Content="{i18n:T '移除选中'}" Click="OnRemoveSelected" />
                        <Button Content="{i18n:T '清空'}" Click="OnClear" />
                        <TextBlock Name="CountLbl" Text="{i18n:T '0 张'}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuteBrush}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Classes="groupHint" Text="{i18n:T '支持 RAW（ARW/NEF/CR2/DNG 等）与扫描仪 TIFF。多选 = 整卷。'}" />
                </StackPanel>

                <!-- ── 底片分割（仅扫描件）───────────────────────────── -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{i18n:T '底片分割（仅扫描件）'}" FontWeight="SemiBold" />
                    <CheckBox Name="SplitChk" Content="{i18n:T '导入时识别一张里的多格底片并分割'}"
                              ToolTip.Tip="{i18n:T '扫描仪常把一整条底片扫成一张图。勾选后导入时先识别每条有几格，并弹窗让你确认分隔线。'}" />
                    <TextBlock Classes="groupHint" TextWrapping="Wrap"
                               Text="{i18n:T '不勾选则一个文件按一帧导入——已经在扫描软件里切好、或本来就是一格一张时用这个。相机 RAW 不受影响，始终一张一帧。'}" />
                </StackPanel>

                <!-- ── 翻拍光源 ─────────────────────────────────────── -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{i18n:T '翻拍光源（仅相机 RAW）'}" FontWeight="SemiBold" />
                    <RadioButton Name="SrcB" GroupName="src" Content="{i18n:T '宽谱光源（白光）— Path B'}" IsChecked="True" />
                    <RadioButton Name="SrcA" GroupName="src" Content="{i18n:T '窄谱光源（RGB 合成）— Path A，需校正图'}"
                                 Checked="OnSourceChanged" Unchecked="OnSourceChanged"
                                 ToolTip.Tip="{i18n:T 'RGB LED 灯板翻拍：分别拍纯红/绿/蓝光的三张空白灯板 RAW（放同一文件夹，自动识别），据此计算分光解耦矩阵，更精确还原色彩。'}" />
                    <StackPanel Name="CalRow" IsVisible="False" Spacing="4" Margin="20,2,0,0">
                        <TextBlock Text="{i18n:T '校正图目录（含红/绿/蓝三张空白灯板 RAW）'}" Foreground="{DynamicResource TextMuteBrush}" FontSize="11" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Name="CalEdit" Grid.Column="0" IsReadOnly="True" Margin="0,0,6,0"
                                     Watermark="{i18n:T '选择含 R/G/B 校正图的文件夹'}" />
                            <Button Grid.Column="1" Content="{i18n:T '选择…'}" Click="OnPickCal" />
                        </Grid>
                        <TextBlock Name="CalDetect" Classes="groupHint" Text="" />
                    </StackPanel>
                </StackPanel>

                <!-- ── LCC 平场校正 ─────────────────────────────────── -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{i18n:T 'LCC 平场校正（可选）'}" FontWeight="SemiBold" />
                    <CheckBox Name="LccChk" Content="{i18n:T '启用 LCC 平场校正'}"
                              IsCheckedChanged="OnLccToggled"
                              ToolTip.Tip="{i18n:T '拍一张均匀光的平场参考图，逐像素/逐通道修正本翻拍镜头的暗角与角落偏色。'}" />
                    <Grid Name="LccRow" ColumnDefinitions="*,Auto" IsVisible="False" Margin="20,2,0,0">
                        <TextBox Name="LccEdit" Grid.Column="0" IsReadOnly="True" Margin="0,0,6,0"
                                 Watermark="{i18n:T '均匀光的平场参考图（RAW 或 TIFF）'}" />
                        <Button Grid.Column="1" Content="{i18n:T '选择…'}" Click="OnPickLcc" />
                    </Grid>
                </StackPanel>

                <!-- ── 自动整卷分析去色罩 ───────────────────────────── -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{i18n:T '自动整卷分析去色罩'}" FontWeight="SemiBold" />
                    <CheckBox Name="AutoInvertChk" Content="{i18n:T '导入后自动整卷分析去色罩'}"
                              IsChecked="True"
                              ToolTip.Tip="{i18n:T '按顺序自动完成：片基 T_base → 亮部 WB → D-max → 黑白场，无需框选任何区域。'}" />
                    <TextBlock Classes="groupHint" TextWrapping="Wrap"
                               Text="{i18n:T '遍历整卷、汇总成一组参数应用到所有帧，同卷观感一致。当前帧会先出结果，整卷分析在后台继续——需要解码全卷，视帧数和机器约每帧数秒，完成前缩略图与参数仍会变动。不勾选则完全不做任何自动测量，所有参数保持默认值，全部交给你手动标定。'}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
