<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="using:OpenRevelare.Gui.Markup"
             xmlns:ctl="clr-namespace:OpenRevelare.Gui.Controls"
             xmlns:vm="clr-namespace:OpenRevelare.Gui.ViewModels"
             xmlns:views="using:OpenRevelare.Gui.Views"
             x:DataType="vm:LibraryViewModel"
             x:Class="OpenRevelare.Gui.Views.LibraryView">

    <UserControl.Styles>
        <!-- Everything on this wall is clickable, so everything on it has to react to the
             pointer. Border only — a background change would fight the contact sheet's paper.
             Nothing lifts, scales or shadows on hover either: that is a web gallery's idiom,
             and here it would set a wall of photographs in motion under the cursor. -->
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.tile.newTile">
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
        </Style>
        <Style Selector="Border.tile:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
        </Style>
        <!-- Selected reads as a filled-in border, not a colour wash: the card is mostly a
             photograph, and tinting it would lie about the print. -->
        <Style Selector="Border.tile.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.tile.selected:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- The 图库 module: one card per roll, the card's picture is that roll's contact sheet.
         Nothing here decodes a negative — a card is one JPEG read straight to card width. -->
    <Grid ColumnDefinitions="Auto,*" Background="{DynamicResource BgBrush}">

        <!-- ══ 筛选侧栏 ══════════════════════════════════════════════════════
             Facets are built from the catalog index, which is already in memory — the roll
             list is drawn from it, so grouping it costs a LINQ pass, not a query. Hidden
             entirely on an empty catalog: an empty sidebar next to an empty wall is just two
             ways of saying the same nothing.
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Width="232" Padding="16" Margin="12,12,8,12" Classes="surface"
                IsVisible="{Binding !IsEmpty}"
                BorderThickness="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{i18n:T '图库'}" FontSize="{DynamicResource FontLg}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{DynamicResource ElevatedBrush}" CornerRadius="12"
                                Padding="10,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RollCountText}" Classes="readout" Foreground="{DynamicResource TextDimBrush}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{i18n:T '收藏每一卷，让底片重新发光。'}" Foreground="{DynamicResource TextDimBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="{i18n:T '筛选与排序'}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SearchText}" Watermark="{i18n:T '搜索卷名 / 卷号 / 胶卷 / 相机'}" />
                    <!-- 排序: the key picker and its direction. Here rather than in the header
                         because this sidebar is already the "how am I looking at this wall"
                         column; the header is the wall's name and its count. -->
                    <Grid ColumnDefinitions="*,Auto">
                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort}"
                                  ToolTip.Tip="{i18n:T '卷墙的排列顺序。该项为空的卷排在最后'}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SortOption">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0"
                                Click="OnSortDirectionClick"
                                AutomationProperties.Name="{i18n:T '排序方向'}"
                                ToolTip.Tip="{Binding SortDirectionTip}">
                            <!-- Two glyphs, one visible: a converter for a two-state icon is a
                                 class to find and a binding to read, where this is the state
                                 itself. -->
                            <Panel>
                                <ctl:Icon Data="{StaticResource IcoSortDesc}" IsVisible="{Binding SortDescending}" />
                                <ctl:Icon Data="{StaticResource IcoSort}" IsVisible="{Binding !SortDescending}" />
                            </Panel>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding FilterSummary}" FontSize="{DynamicResource FontXs}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuteBrush}" />
                        <Button Grid.Column="1" Content="{i18n:T '清除'}" FontSize="{DynamicResource FontXs}" Padding="8,1"
                                IsVisible="{Binding HasActiveFilter}" Click="OnClearFiltersClick" />
                    </Grid>
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding Facets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FilterFacet">
                                <StackPanel Margin="0,0,0,14" Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontXs}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextDimBrush}" />
                                    <ItemsControl ItemsSource="{Binding Options}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FilterOption">
                                                <CheckBox IsChecked="{Binding IsChecked}"
                                                          Content="{Binding Label}" FontSize="{DynamicResource FontSm}"
                                                          MinHeight="0" Padding="7,1,0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- The wall starts directly below navigation; its full height belongs to scrolling previews. -->
        <ScrollViewer Name="RollWallScroll" Grid.Column="1" Padding="3,7,12,12"
                      VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsEmpty}">
            <ItemsControl ItemsSource="{Binding Rolls}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RollCard">
                      <Panel>

                        <!-- 新建卷 tile: same footprint as a roll card so the wall stays a grid,
                             and it leads the row it is in. One click, not two — it is a button. -->
                        <Border Classes="tile newTile" IsVisible="{Binding IsNewTile}" Margin="5" Width="{Binding $parent[views:LibraryView].RollCardWidth}" Height="240"
                                BorderThickness="1" CornerRadius="10" Padding="10"
                                Cursor="Hand" Tapped="OnNewTileTapped">
                            <StackPanel Spacing="9">
                                <!-- Empty, not filled: this cell is a slot waiting for a roll, and
                                     drawing it as a filled frame with a big ＋ made it compete with
                                     the photographs beside it for the eye. -->
                                <Border Height="150" CornerRadius="8" Background="{DynamicResource GrooveBrush}">
                                    <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource ElevatedBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ctl:Icon Data="{StaticResource IcoPlus}" Foreground="{DynamicResource TextDimBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{i18n:T '新建卷…'}" FontSize="{DynamicResource FontMd}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{i18n:T '选择一张或多张负片（多选 = 整卷）'}" FontSize="{DynamicResource FontXs}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMuteBrush}" />
                                    <TextBlock Text=" " FontSize="{DynamicResource FontXs}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Name="Card" Classes="tile" Classes.selected="{Binding IsSelected}"
                                Margin="5" Width="{Binding $parent[views:LibraryView].RollCardWidth}" Height="240" Cursor="Hand"
                                IsVisible="{Binding !IsNewTile}"
                                BorderThickness="1" CornerRadius="10" Padding="10"
                                DoubleTapped="OnCardDoubleTapped"
                                PointerPressed="OnCardPressed">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{i18n:T '打开这一卷'}" Click="OnOpenClick" />
                                    <MenuItem Header="{i18n:T '重命名…'}" Click="OnRenameClick" />
                                    <MenuItem Header="{i18n:T '卷信息…'}" Click="OnInfoClick"
                                              ToolTip.Tip="{i18n:T '相机 / 胶卷 / 卷号 / 冲洗 …，会烧在印样标识条上'}" />
                                    <MenuItem Header="{i18n:T '导出印样…'}" Click="OnExportSheetClick"
                                              ToolTip.Tip="{i18n:T '另存这一卷的印样封面（不需要重新解码整卷）'}" />
                                    <MenuItem Header="{i18n:T '重新定位工程…'}" Click="OnRelocateClick"
                                              ToolTip.Tip="{i18n:T '工程文件被移动过时，指向它的新位置'}" />
                                    <Separator />
                                    <MenuItem Header="{i18n:T '在资源管理器中显示'}" Click="OnRevealClick" />
                                    <Separator />
                                    <MenuItem Header="{i18n:T '从目录移除（保留工程文件）'}" Click="OnForgetClick" />
                                    <MenuItem Header="{i18n:T '删除工程文件…'}" Click="OnDeleteClick" />
                                </ContextMenu>
                            </Border.ContextMenu>

                            <StackPanel Spacing="9">
                                <!-- The cover sits on the DARKEST surface in the window, not on a
                                     panel grey: a contact sheet is a print, and the darker the
                                     mount the less the chrome argues with what is on it. -->
                                <Border Height="150" Background="{DynamicResource GrooveBrush}"
                                        CornerRadius="8" ClipToBounds="True">
                                    <Panel>
                                        <TextBlock Text="{i18n:T '（暂无印样）'}" FontSize="{DynamicResource FontXs}"
                                                   IsVisible="{Binding HasNoCover}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuteBrush}" />
                                        <Image Source="{Binding Cover}" Stretch="Uniform" />
                                    </Panel>
                                </Border>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontMd}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontXs}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{DynamicResource TextDimBrush}" />
                                    <!-- Frame count and timestamp are measurements, so they are set
                                         like the other readouts in the app rather than as prose. -->
                                    <TextBlock Text="{Binding Detail}" Classes="readout"
                                               Foreground="{DynamicResource TextMuteBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                      </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Grid.ColumnSpan="2" IsVisible="{Binding IsEmpty}" Margin="12"
                Classes="surface">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="460" Margin="24">
                <Border Width="56" Height="56" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                    <Viewbox Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ctl:Icon Data="{StaticResource IcoFilm}" Foreground="{DynamicResource AccentBrush}" />
                    </Viewbox>
                </Border>
                <TextBlock Text="{i18n:T '从第一卷开始'}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{i18n:T '导入负片，完成校准，再细调成片。每一卷都会自动保存在这里。'}"
                           Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Classes="primary" Click="OnNewRollClick" HorizontalAlignment="Center" Padding="22,10">
                    <Grid ColumnDefinitions="Auto,*">
                        <ctl:Icon Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Data="{StaticResource IcoPlus}" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{i18n:T '导入第一卷'}" />
                    </Grid>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="{i18n:T '01 导入'}" Classes="eyebrow" />
                    <ctl:Icon Data="{StaticResource IcoChevron}" Foreground="{DynamicResource TextMuteBrush}" />
                    <TextBlock Text="{i18n:T '02 校准'}" Classes="eyebrow" />
                    <ctl:Icon Data="{StaticResource IcoChevron}" Foreground="{DynamicResource TextMuteBrush}" />
                    <TextBlock Text="{i18n:T '03 成片'}" Classes="eyebrow" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
