<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:OpenRevelare.Gui.Markup"
        xmlns:models="clr-namespace:OpenRevelare.Gui.Models"
        x:Class="OpenRevelare.Gui.Views.SplitDialog"
        Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Title="{i18n:T '底片分割'}">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,8"
                   Text="{i18n:T '扫描件通常一个文件装着一整条底片。下面是自动识别的分割结果：拖动分隔线可微调，双击分隔线删除，双击画面空白处新增。外框四条边同样可以拖动——识别切进画面时把它拉回来。识别不准时改「格数」重新等分即可。'}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <TextBlock Name="TotalLbl" VerticalAlignment="Center" Foreground="{DynamicResource TextMuteBrush}" />
            <Panel Width="1" />
            <Button Content="{i18n:T '全部不分割'}" Click="OnSkipAllClick" HorizontalAlignment="Left" />
            <Panel Width="420" />
            <Button Content="{i18n:T '取消导入'}" Click="OnCancelClick" />
            <Button Content="{i18n:T '按此导入'}" Click="OnAcceptClick" />
        </StackPanel>

        <Grid ColumnDefinitions="200,10,*">
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="4">
                <ListBox Name="FileList" Background="Transparent" SelectionChanged="OnFileSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:StripPlan">
                            <Grid ColumnDefinitions="*,Auto" Margin="2">
                                <TextBlock Grid.Column="0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextMuteBrush}"
                                           FontFamily="JetBrains Mono, Consolas, monospace" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,10,0,0">
                    <TextBlock Grid.Column="0" Text="{i18n:T '格数'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="−" Click="OnFewerClick" Width="32" />
                    <TextBlock Grid.Column="2" Name="CountLbl" VerticalAlignment="Center" MinWidth="36"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               FontFamily="JetBrains Mono, Consolas, monospace" />
                    <Button Grid.Column="3" Content="+" Click="OnMoreClick" Width="32" />
                    <CheckBox Grid.Column="5" Name="SkipChk" Content="{i18n:T '这条不分割'}" Click="OnSkipToggled" />
                </Grid>

                <!-- Margin: applies to the WHOLE import, not the selected strip, so it sits on its
                     own row rather than beside the per-strip 格数 controls. -->
                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,Auto,Auto,*" Margin="0,8,0,0">
                    <TextBlock Grid.Column="0" Text="{i18n:T '裁切余量'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider Grid.Column="1" Name="MarginSlider" Width="180" VerticalAlignment="Center"
                            Minimum="0" Maximum="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            Value="0.15" PropertyChanged="OnMarginChanged" />
                    <TextBlock Grid.Column="2" Name="MarginLbl" VerticalAlignment="Center" MinWidth="46"
                               TextAlignment="Right" Margin="6,0,0,0"
                               FontFamily="JetBrains Mono, Consolas, monospace" />
                    <TextBlock Grid.Column="4" Name="MarginHintLbl" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource TextMuteBrush}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <TextBlock DockPanel.Dock="Bottom" Name="HintLbl" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuteBrush}" FontSize="11" />

                <!-- View controls: they change how the strip is LOOKED at and nothing else.
                     No rotation or zoom here reaches the imported frames — orientation is the
                     main window's business, per frame. This is here so a strip that was scanned
                     sideways, or whose gutters are too small to judge at fit, can still be cut
                     accurately. -->
                <!-- Glyph buttons carry Classes="icon", the house style for exactly this: square,
                     chrome-less, Padding=0. The plain Button style sets Padding="12,6", so pinning
                     a 32px width instead left 8px of content box and clipped the glyph. The hint
                     text is allowed to ellipsize rather than force the row wider than the panel —
                     the buttons keep their size and the sentence gives way, not the other way
                     round. -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
                      Margin="0,0,0,6">
                    <Button Grid.Column="0" Classes="icon" Content="↺" Click="OnRotateLeftClick"
                            ToolTip.Tip="{i18n:T '逆时针旋转 90°（仅影响预览）'}" />
                    <Button Grid.Column="1" Classes="icon" Content="↻" Click="OnRotateRightClick"
                            Margin="2,0,0,0"
                            ToolTip.Tip="{i18n:T '顺时针旋转 90°（仅影响预览）'}" />
                    <Button Grid.Column="2" Classes="icon" Content="−" Click="OnZoomOutClick"
                            Margin="12,0,0,0" ToolTip.Tip="{i18n:T '缩小'}" />
                    <TextBlock Grid.Column="3" Name="ZoomLbl" VerticalAlignment="Center" MinWidth="52"
                               TextAlignment="Center" Text="100%"
                               FontFamily="JetBrains Mono, Consolas, monospace" />
                    <Button Grid.Column="4" Classes="icon" Content="+" Click="OnZoomInClick"
                            ToolTip.Tip="{i18n:T '放大'}" />
                    <Button Grid.Column="5" Content="{i18n:T '复位'}" Click="OnZoomResetClick"
                            Margin="12,0,0,0" Padding="10,4" MinHeight="30"
                            ToolTip.Tip="{i18n:T '回到适应窗口、未旋转'}" />
                    <TextBlock Grid.Column="7" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"
                               Foreground="{DynamicResource TextMuteBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{i18n:T '滚轮缩放，放大后拖动空白处平移'}" />
                </Grid>

                <!-- Two canvases, deliberately. Stage is the CLIP and the input surface; Scene
                     inside it carries the zoom/rotate transform and holds the picture and every
                     overlay. They cannot be the same control: a control's own RenderTransform is
                     applied AFTER its own clip, so transforming the clipping canvas let the
                     zoomed preview escape the grey viewer and spill over the panel around it.
                     Stage also needs a Background to receive pointer events on empty areas —
                     a transparent Canvas is not hit-testable, which is what pans the picture. -->
                <Border Background="{DynamicResource ViewerBrush}" Padding="6" CornerRadius="4">
                    <Canvas Name="Stage" ClipToBounds="True" Background="Transparent"
                            PointerPressed="OnStagePressed"
                            PointerMoved="OnStageMoved"
                            PointerReleased="OnStageReleased"
                            PointerWheelChanged="OnStageWheel">
                        <Canvas Name="Scene" />
                    </Canvas>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
