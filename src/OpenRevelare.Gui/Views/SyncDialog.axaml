<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:OpenRevelare.Gui.Markup"
        xmlns:m="using:OpenRevelare.Gui.Models"
        x:Class="OpenRevelare.Gui.Views.SyncDialog"
        x:DataType="m:SyncOptions"
        Width="360" Height="430"
        WindowStartupLocation="CenterOwner"
        Title="{i18n:T '选择色彩同步项'}">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8"
                   Text="{i18n:T '这里控制底片和观感参数的广播范围。构图（旋转、翻转、拉直、裁切）在几何面板中单独同步。'}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,10,0,0">
            <Button Content="{i18n:T '关闭'}" Click="OnCloseClick" />
        </StackPanel>
        <ScrollViewer>
            <StackPanel Spacing="4">
                <TextBlock Text="{i18n:T '底片 · Cineon（Stage 1）'}" FontWeight="Bold" Margin="0,4" />
                <CheckBox Content="{i18n:T '片基与两端点（含色偏）'}" IsChecked="{Binding CalFilmBase}" />
                <CheckBox Content="{i18n:T '色度通道缩放'}" IsChecked="{Binding CalChroma}" />
                <CheckBox Content="{i18n:T '镜头畸变 / 暗角 / LCC'}" IsChecked="{Binding CalLens}" />
                <CheckBox Content="{i18n:T '齿孔启用 / 阈值'}" IsChecked="{Binding CalSprocket}" />
                <TextBlock Text="{i18n:T '观感 · Display（Stage 2）'}" FontWeight="Bold" Margin="0,8,0,4" />
                <CheckBox Content="{i18n:T '白平衡（色温 / 色调）'}" IsChecked="{Binding SceneWb}" />
                <CheckBox Content="{i18n:T '曝光'}" IsChecked="{Binding SceneExposure}" />
                <CheckBox Content="{i18n:T '影调（黑白场 / 反差 / 高光阴影 / 饱和度）'}" IsChecked="{Binding SceneTone}" />
                <CheckBox Content="{i18n:T '色调曲线'}" IsChecked="{Binding SceneCurves}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
