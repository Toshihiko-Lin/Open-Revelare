<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:OpenRevelare.Gui.Markup"
        xmlns:m="using:OpenRevelare.Gui.Models"
        x:Class="OpenRevelare.Gui.Views.SyncDialog"
        x:DataType="m:SyncOptions"
        Width="460" Height="440" MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Title="{i18n:T '选择色彩同步项'}">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Classes="dialogNote" Margin="0,0,0,16"
                   Text="{i18n:T '色彩同步项 · 更改即时生效'}"
                   ToolTip.Tip="{i18n:T '这里只同步色彩参数。齿孔遮罩在齿孔设置中同步；旋转、翻转和拉直在预览顶部同步；裁切在裁切面板中同步。'}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,10,0,0">
            <Button Content="{i18n:T '关闭'}" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
        <ScrollViewer>
            <StackPanel Spacing="4">
                <TextBlock Text="{i18n:T '底片校准'}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <CheckBox Content="{i18n:T '片基与两端点（含色偏）'}" IsChecked="{Binding CalFilmBase}" />
                <CheckBox Content="{i18n:T '色度通道缩放'}" IsChecked="{Binding CalChroma}" />
                <CheckBox Content="{i18n:T '镜头畸变 / 暗角 / LCC'}" IsChecked="{Binding CalLens}" />
                <TextBlock Text="{i18n:T '成片调整'}" FontWeight="SemiBold" Margin="0,16,0,8" />
                <CheckBox Content="{i18n:T '白平衡（色温 / 色调）'}" IsChecked="{Binding SceneWb}" />
                <CheckBox Content="{i18n:T '曝光'}" IsChecked="{Binding SceneExposure}" />
                <CheckBox Content="{i18n:T '影调（黑白场 / 反差 / 高光阴影 / 饱和度）'}" IsChecked="{Binding SceneTone}" />
                <CheckBox Content="{i18n:T '色调曲线'}" IsChecked="{Binding SceneCurves}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
