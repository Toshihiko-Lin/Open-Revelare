<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:OpenRevelare.Gui.Markup"
        x:Class="OpenRevelare.Gui.Views.InfoDialog"
        Width="460" SizeToContent="Height" MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="OpenRevelare">
    <!-- 高度跟着内容走,上限仍是原来的 520。这个对话框最早只承载 快捷键 / 关于 两页长文,
         520 是照着它们定的;后来色彩管线迁移这类三四行的短文案也用它,于是文字只占顶部约
         110 px,中间一大片空白才到按钮。固定高度对长文是对的,对短文就是个空盒子。
         上限保留 520:长文的观感一字不变,短文自己收到该有的大小。 -->
    <DockPanel Margin="16">
        <!-- Header. The mark only shows on 关于 (see InfoDialog.About) — 快捷键 and the
             notices are reading material, not a brand page. -->
        <StackPanel Name="Header" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12"
                    Margin="0,0,0,10">
            <Image Name="Logo" Width="48" Height="48" IsVisible="False"
                   Source="/Assets/icons/app-512.png" VerticalAlignment="Center" />
            <TextBlock Name="TitleText" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" />
        </StackPanel>
        <!-- 关闭 is the only button most of the time; WithAction() reveals ActionButton (used by
             the update notice for 前往下载) and relabels this one. WithSecondaryAction() reveals
             the third — the 国内镜像下载 link, which only the update notice uses and only when
             both mirrors carry the release. Declared left of ActionButton so the primary stays
             rightmost as buttons appear. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <!-- IsCancel so Esc closes the dialog. Without it the only way out of a modal
                 with an action button was to hit the mouse target — and the one dialog where
                 that matters is the one-way colour-pipeline migration, where the keyboard
                 offered Enter (do it) and no way to say no. Closing never runs the action. -->
            <Button Name="CloseButton" Content="{i18n:T '关闭'}" IsCancel="True"
                    Click="OnCloseClick" />
            <Button Name="SecondaryActionButton" IsVisible="False" Click="OnSecondaryActionClick" />
            <Button Name="ActionButton" IsVisible="False" Click="OnActionClick" />
        </StackPanel>
        <ScrollViewer>
            <TextBlock Name="BodyText" TextWrapping="Wrap" LineHeight="20" />
        </ScrollViewer>
    </DockPanel>
</Window>
