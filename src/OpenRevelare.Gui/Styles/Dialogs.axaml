<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared with the editing workbench. Native window chrome remains platform owned. -->
    <Style Selector="Window.dialog">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Window.dialog Button, Window.dialog ToggleButton">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style Selector="Window.dialog TextBox, Window.dialog ComboBox, Window.dialog AutoCompleteBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Window.dialog CheckBox, Window.dialog RadioButton">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Window.dialog TextBlock.dialogTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style Selector="Window.dialog TextBlock.dialogNote">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Window.dialog TextBlock.sectionHead">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Window.dialog TextBlock.preferenceCategoryTitle">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Window.dialog ListBox.preferencesNav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,2,12,0" />
    </Style>
    <Style Selector="Window.dialog ListBox.preferencesNav ListBoxItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Window.dialog ListBox.preferencesNav ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Window.dialog Border.preferenceCard">
        <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="Window.dialog Button.destructive">
        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource AccentFgBrush}" />
    </Style>
    <Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse">
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource AccentFgBrush}" />
    </Style>
</Styles>
