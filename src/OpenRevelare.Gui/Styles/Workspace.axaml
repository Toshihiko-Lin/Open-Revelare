<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:OpenRevelare.Gui.Controls">
    <Styles.Resources>
        <!-- Keep TabStrip's selection and arrow-key semantics; own its entire visual surface. -->
        <ControlTheme x:Key="InspectorTabTheme" TargetType="TabStripItem">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="TabFace" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource HoverSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style Selector="^:selected:pointerover">
                <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource PressSoftBrush}" />
            </Style>
            <Style Selector="^:focus-visible">
                <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.4" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
    <Style Selector="ctl|HistogramView">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="GridBrush" Value="{DynamicResource BorderSoftBrush}" />
        <Setter Property="AxisBrush" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="WhiteMarkerBrush" Value="{DynamicResource WarnBrush}" />
        <Setter Property="ClipMarkerBrush" Value="#C65E49" />
    </Style>
    <Style Selector="ctl|WaveformView">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="GridBrush" Value="{DynamicResource BorderSoftBrush}" />
    </Style>
    <!-- Surface hierarchy replaces repeated outlines; focus keeps an explicit edge. -->
    <Style Selector="Button, ToggleButton">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="ToggleButton.sampling">
        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Grid.pairedActions > Button, Grid.pairedActions > ToggleButton">
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.workspaceTab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Width" Value="108" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.workspaceTab TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Button.workspaceTab.active">
        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.workspaceTab.active:pointerover">
        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
    </Style>
    <Style Selector="Button.quiet">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>
    <Style Selector="Button.primary TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}" />
    </Style>
    <Style Selector="Button.primary ctl|Icon">
        <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}" />
    </Style>
    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuteBrush}" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,12,10,0" />
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button TextBlock, ToggleButton TextBlock, CheckBox TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ComboBox TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Grid#InspectorWorkspace Expander">
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Grid#InspectorWorkspace Expander /template/ Border#SectionSurface">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,8,0,2" />
    </Style>
    <Style Selector="Grid#InspectorWorkspace Grid.pairedActions > Button, Grid#InspectorWorkspace Grid.pairedActions > ToggleButton">
        <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Grid#InspectorWorkspace Grid.pairedActions > Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.scopeAction">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.selectionActions">
        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    </Style>
    <Style Selector="Border.selectionActions TextBlock.selectionSummary">
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.selectionActions Button.selectionClear">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>
    <Style Selector="Border.selectionActions Button.selectionAction">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.selectionActions Button.selectionAction.secondary">
        <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Border.frameMarkers">
        <Setter Property="Background" Value="#B817181A" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4,3" />
    </Style>
    <Style Selector="Button.renderSummary">
        <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Button.renderSummary:pointerover">
        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Border.taskRow">
        <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.calibrationStage Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Border.finishingStage Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Grid.repairStage Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TabItem.calibrationTab:selected">
        <Setter Property="Background" Value="{DynamicResource CalibrationTintBrush}" />
    </Style>
    <Style Selector="TabItem.finishingTab:selected">
        <Setter Property="Background" Value="{DynamicResource FinishingTintBrush}" />
    </Style>
    <Style Selector="TabItem.calibrationTab:selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TabItem.finishingTab:selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TabItem.calibrationTab:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="Background" Value="{DynamicResource CalibrationAccentBrush}" />
    </Style>
    <Style Selector="TabItem.finishingTab:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="Background" Value="{DynamicResource FinishingAccentBrush}" />
    </Style>
    <Style Selector="Border.calibrationStage Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TabStrip.inspectorTabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="TabStrip.inspectorTabs TabStripItem">
        <Setter Property="Theme" Value="{StaticResource InspectorTabTheme}" />
    </Style>
    <Style Selector="Border.orientationTools Button.icon">
        <Setter Property="Width" Value="26" />
    </Style>
    <Style Selector="Grid.compactTools TextBlock.toolCaption">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.compactTools ToggleButton.viewMode">
        <Setter Property="Width" Value="30" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Grid.compactTools ToggleButton.viewMode ctl|Icon">
        <Setter Property="Margin" Value="0" />
    </Style>
</Styles>
