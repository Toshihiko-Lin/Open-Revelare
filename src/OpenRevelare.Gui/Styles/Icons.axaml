<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="using:OpenRevelare.Gui.Controls">

    <!--
      ══ OpenRevelare line-icon set ══════════════════════════════════════════════════
      One family, one grid, one weight. Every glyph is authored on a 16×16 grid with
      a 1.5 px round-capped stroke and a ~2.5 px inset, so they line up optically no
      matter which control they sit in. Draw them with <ctl:Icon Data="{StaticResource
      IcoXxx}" /> — never with a raw Path, or the stroke weight drifts.

      Same vocabulary as the Python build's theme.icon() painter (marquee / wand /
      copy / check / crop / grid), extended with the glyphs this UI needs.
    -->

    <!-- ── History / state ─────────────────────────────────────────────────── -->
    <StreamGeometry x:Key="IcoUndo">M2.5 6.5H9.5A3.5 3.5 0 0 1 9.5 13.5H6M2.5 6.5L5.5 3.5M2.5 6.5L5.5 9.5</StreamGeometry>
    <StreamGeometry x:Key="IcoRedo">M13.5 6.5H6.5A3.5 3.5 0 0 0 6.5 13.5H10M13.5 6.5L10.5 3.5M13.5 6.5L10.5 9.5</StreamGeometry>
    <StreamGeometry x:Key="IcoReset">M13 8A5 5 0 1 1 8 3M6.2 1.2L8 3L6.2 4.8</StreamGeometry>

    <!-- ── Viewing ─────────────────────────────────────────────────────────── -->
    <StreamGeometry x:Key="IcoFilm">M2.5 4H13.5V12H2.5ZM5 4V12M11 4V12M2.5 6H5M2.5 8H5M2.5 10H5M11 6H13.5M11 8H13.5M11 10H13.5</StreamGeometry>
    <StreamGeometry x:Key="IcoCompare">M2.5 3.5H13.5V12.5H2.5ZM8 2.5V13.5M4 8H6.3M5.2 6.9L4 8L5.2 9.1M12 8H9.7M10.8 6.9L12 8L10.8 9.1</StreamGeometry>
    <StreamGeometry x:Key="IcoFit">M6 2.5H3.5A1 1 0 0 0 2.5 3.5V6M10 2.5H12.5A1 1 0 0 1 13.5 3.5V6M6 13.5H3.5A1 1 0 0 1 2.5 12.5V10M10 13.5H12.5A1 1 0 0 0 13.5 12.5V10</StreamGeometry>
    <StreamGeometry x:Key="IcoActual">M2.5 2.5H13.5V13.5H2.5ZM6 6H10V10H6Z</StreamGeometry>
    <StreamGeometry x:Key="IcoGrid">M2.5 2.5H7V7H2.5ZM9 2.5H13.5V7H9ZM2.5 9H7V13.5H2.5ZM9 9H13.5V13.5H9Z</StreamGeometry>

    <!-- ── Tools ───────────────────────────────────────────────────────────── -->
    <!-- marquee = every 框选 sampling toggle -->
    <StreamGeometry x:Key="IcoMarquee">M2.5 5.5V3.5A1 1 0 0 1 3.5 2.5H5.5M10.5 2.5H12.5A1 1 0 0 1 13.5 3.5V5.5M13.5 10.5V12.5A1 1 0 0 1 12.5 13.5H10.5M5.5 13.5H3.5A1 1 0 0 1 2.5 12.5V10.5M7.3 2.5H8.7M7.3 13.5H8.7M2.5 7.3V8.7M13.5 7.3V8.7</StreamGeometry>
    <!-- wand = every 自动/智能 action -->
    <StreamGeometry x:Key="IcoWand">M2.5 13.5L9.8 6.2M11.8 2.2V5.2M10.3 3.7H13.3M5.8 2.2V4M4.9 3.1H6.7</StreamGeometry>
    <StreamGeometry x:Key="IcoCrop">M4.5 1.5V11.5H14.5M1.5 4.5H11.5V14.5</StreamGeometry>
    <StreamGeometry x:Key="IcoRotateCw">M14.4 3V6.6H10.8M12.89 9.6A5.4 5.4 0 1 1 11.62 3.98L14.4 6.6</StreamGeometry>
    <StreamGeometry x:Key="IcoRotateCcw">M1.2 3V6.6H4.8M2.71 9.6A5.4 5.4 0 1 0 3.98 3.98L1.2 6.6</StreamGeometry>
    <StreamGeometry x:Key="IcoFlipH">M8 2V14M6 4.5L2 8L6 11.5ZM10 4.5L14 8L10 11.5Z</StreamGeometry>
    <StreamGeometry x:Key="IcoFlipV">M2 8H14M4.5 6L8 2L11.5 6ZM4.5 10L8 14L11.5 10Z</StreamGeometry>
    <!-- level = drag a reference line, declare it horizontal / vertical. The tilted stroke is the
         line you draw; the straight one is the axis it will be rotated onto. -->
    <StreamGeometry x:Key="IcoLevelH">M2.5 10.5L13.5 6.5M2.5 13.5H13.5</StreamGeometry>
    <StreamGeometry x:Key="IcoLevelV">M5.5 2.5L9.5 13.5M2.5 2.5V13.5</StreamGeometry>

    <!-- ── Roll management / clipboard ─────────────────────────────────────── -->
    <StreamGeometry x:Key="IcoPlus">M8 3.5V12.5M3.5 8H12.5</StreamGeometry>
    <StreamGeometry x:Key="IcoMinus">M3.5 8H12.5</StreamGeometry>
    <StreamGeometry x:Key="IcoCopy">M6 6H13V13H6ZM10 6V3H3V10H6</StreamGeometry>
    <StreamGeometry x:Key="IcoCheck">M3.5 8.5L6.5 11.5L12.5 4.5</StreamGeometry>
    <StreamGeometry x:Key="IcoLayers">M8 2L14 5.5L8 9L2 5.5ZM2 9.5L8 13L14 9.5</StreamGeometry>
    <StreamGeometry x:Key="IcoTrash">M3 4.5H13M6.5 4.5V3A0.5 0.5 0 0 1 7 2.5H9A0.5 0.5 0 0 1 9.5 3V4.5M4.5 4.5V13A1 1 0 0 0 5.5 14H10.5A1 1 0 0 0 11.5 13V4.5M6.8 7V11.5M9.2 7V11.5</StreamGeometry>
    <!-- Shortest-to-longest bars beside a down arrow: sort ascending. -->
    <StreamGeometry x:Key="IcoSort">M2.5 4H7.5M2.5 8H9.5M2.5 12H11.5M13 3V12M11 10L13 12L15 10</StreamGeometry>

    <!-- ── Output ──────────────────────────────────────────────────────────── -->
    <StreamGeometry x:Key="IcoExport">M8 2.5V10M5.2 7.3L8 10.1L10.8 7.3M2.5 11V12.5A1 1 0 0 0 3.5 13.5H12.5A1 1 0 0 0 13.5 12.5V11</StreamGeometry>

    <!-- ── Structural ──────────────────────────────────────────────────────── -->
    <StreamGeometry x:Key="IcoChevron">M6 3.5L10.5 8L6 12.5</StreamGeometry>
    <StreamGeometry x:Key="IcoClose">M4.5 4.5L11.5 11.5M11.5 4.5L4.5 11.5</StreamGeometry>

    <!-- ══ The Icon control template ═══════════════════════════════════════════ -->
    <ControlTheme x:Key="{x:Type ctl:Icon}" TargetType="ctl:Icon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Path Data="{TemplateBinding Data}"
                      Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="{TemplateBinding StrokeThickness}"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Stretch="None" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
