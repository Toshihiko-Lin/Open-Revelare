<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenRevelare.Tests" />
    <InternalsVisibleTo Include="OpenRevelare.ComputeBenchmark" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <ProjectReference Include="..\OpenRevelare.ColorManagement\OpenRevelare.ColorManagement.csproj" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\packaging\metadata\licenses\*.txt" Link="licenses\metadata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Cloud/file-sync conflict copies are recovery artifacts, not source files. Keep them on
       disk for inspection, but never let SDK wildcard compilation define every type twice. -->
  <ItemGroup>
    <Compile Remove="**\*.sync-conflict-*.cs" />
  </ItemGroup>

  <!--
    随程序发行的 LUT 文件夹：Assets\Luts\*.cube 原样复制到产物的 luts\ 下（Gui / Cli / Tests
    引用 Core 时一并带走），选片器把这个文件夹列在最前面，工程里存的是 :luts/<文件名> 这样的
    记号而不是本机绝对路径——换台机器打开照样渲染。见 PrintLuts.BundledDir / PrintLuts.Bundled。

    两张 D65 只嵌进程序集，不再复制一份到 luts/。旧版 :kodak-2383 / :fujifilm-3513di
    和新版 :luts/<文件名> 均解析到同一份资源，选片器仍列出全部六张 LUT。
  -->
  <ItemGroup>
    <None Include="Assets\Luts\*.cube" Link="luts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Luts\Rec709 Kodak 2383 D65.cube;Assets\Luts\Rec709 Fujifilm 3513DI D65.cube" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="Assets\Luts\Rec709 Kodak 2383 D65.cube" LogicalName="OpenRevelare.Core.Assets.Luts.kodak-2383.cube" />
    <EmbeddedResource Include="Assets\Luts\Rec709 Fujifilm 3513DI D65.cube" LogicalName="OpenRevelare.Core.Assets.Luts.fujifilm-3513di.cube" />
  </ItemGroup>

</Project>
