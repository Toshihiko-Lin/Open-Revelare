<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRevelare.ColorManagement\OpenRevelare.ColorManagement.csproj" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="Sdcb.LibRaw" Version="0.21.1.7" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.*" />
  </ItemGroup>

  <!--
    随程序发行的 LUT 文件夹：Assets\Luts\*.cube 原样复制到产物的 luts\ 下（Gui / Cli / Tests
    引用 Core 时一并带走），选片器把这个文件夹列在最前面，工程里存的是 :luts/<文件名> 这样的
    记号而不是本机绝对路径——换台机器打开照样渲染。见 PrintLuts.BundledDir / PrintLuts.Bundled。

    两张 D65 同时仍嵌进程序集：D-033 之前的工程存的是 :kodak-2383 / :fujifilm-3513di，那两个
    记号继续从资源里解析（PrintLuts.Builtins），旧工程不需要迁移。
  -->
  <ItemGroup>
    <None Include="Assets\Luts\*.cube" Link="luts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\Luts\Rec709 Kodak 2383 D65.cube" LogicalName="OpenRevelare.Core.Assets.Luts.kodak-2383.cube" />
    <EmbeddedResource Include="Assets\Luts\Rec709 Fujifilm 3513DI D65.cube" LogicalName="OpenRevelare.Core.Assets.Luts.fujifilm-3513di.cube" />
  </ItemGroup>

  <!--
    RAW 原生库：Sdcb 只发 win/linux 两个 runtime 包，按目标平台挑一个，别三份都塞进产物。
    没有 RuntimeIdentifier 时（普通 dotnet build / 跑对拍）默认给 Windows，本机开发照旧。
    linux64 包是 Ubuntu 22.04 上编的（glibc 2.35 起），见 packaging/linux/build-appimage.sh。
  -->
  <ItemGroup>
    <PackageReference Include="Sdcb.LibRaw.runtime.win64" Version="0.21.1"
                      Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))" />
    <PackageReference Include="Sdcb.LibRaw.runtime.linux64" Version="0.21.1"
                      Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
  </ItemGroup>

  <!--
    macOS 没有 runtime 包（NuGet 上就是没有），dylib 得自己备：跑
    packaging/macos/bundle-libraw.sh 生成 native/osx-arm64/ 或 native/osx-x64/。
    Sdcb 的加载器在 mac 上按 libraw.23.dylib 这个确切文件名 NativeLibrary.Load，走 assembly
    重载 → 会搜程序目录，所以复制到输出根目录即可被找到。

    **把那份 dylib 复制进产物的 ItemGroup 在 OpenRevelare.Gui.csproj 里，不在这里** ——
    .NET 8 不把 RuntimeIdentifier 传给被引用的类库（publish 时 Core 输出到
    bin/Release/net8.0/ 而不是 .../osx-arm64/），这里的 $(RuntimeIdentifier) 是空的，
    按 RID 挑文件的条件永远不成立。上面那两个 PackageReference 不受影响是因为
    条件在 **restore** 期求值，那时 NuGet 的图里有 RID。
  -->

</Project>
