<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRevelare.ColorManagement\OpenRevelare.ColorManagement.csproj" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- Cloud/file-sync conflict copies are recovery artifacts, not source files. Keep them on
       disk for inspection, but never let SDK wildcard compilation define every type twice. -->
  <ItemGroup>
    <Compile Remove="**\*.sync-conflict-*.cs" />
  </ItemGroup>

  <!--
    随程序发行的 LUT 文件夹：Assets\Luts\*.cube 原样复制到产物的 luts\ 下（Gui / Cli / Tests
    引用 Core 时一并带走），选片器把这个文件夹列在最前面，工程里存的是 :luts/<文件名> 这样的
    记号而不是本机绝对路径——换台机器打开照样渲染。见 PrintLuts.BundledDir / PrintLuts.Bundled。

    两张 D65 同时仍嵌进程序集：D-033 之前的工程存的是 :kodak-2383 / :fujifilm-3513di，那两个
    记号继续从资源里解析（PrintLuts.Builtins），旧工程不需要迁移。
  -->
  <ItemGroup>
    <None Include="Assets\Luts\*.cube" Link="luts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\Luts\Rec709 Kodak 2383 D65.cube" LogicalName="OpenRevelare.Core.Assets.Luts.kodak-2383.cube" />
    <EmbeddedResource Include="Assets\Luts\Rec709 Fujifilm 3513DI D65.cube" LogicalName="OpenRevelare.Core.Assets.Luts.fujifilm-3513di.cube" />
  </ItemGroup>

</Project>
