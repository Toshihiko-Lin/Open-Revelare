<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRevelare.Core\OpenRevelare.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-platform: this package carries the native runtime for win/linux/osx, so no
         per-platform discovery is needed — the CLI/GUI just reference it and inject the
         corrector. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <!-- Already a solution dependency (JPEG); reused here for the Lanczos resampler. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- Weights are installed on demand, never included in the default build/publish. -->
  <ItemGroup>
    <Content Include="..\..\models\DeepWB-NOTICE.txt" Link="models\DeepWB-NOTICE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\models\README.md" Link="models\README.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
